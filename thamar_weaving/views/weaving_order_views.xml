<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weaving Order Search View -->
    <record id="view_weaving_order_search" model="ir.ui.view">
        <field name="name">thamar.weaving.order.search</field>
        <field name="model">thamar.weaving.order</field>
        <field name="arch" type="xml">
            <search string="بحث أوامر التشغيل">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter string="أوامر جارية (تعمل الآن)" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="أوامر مؤكدة" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="أوامر منتهية" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="نسيج دائري" name="filter_circular" domain="[('weaving_type', '=', 'circular')]"/>
                <filter string="نسيج مستطيل / أنوال" name="filter_rectangular" domain="[('weaving_type', '=', 'rectangular')]"/>
                <separator/>
                <filter string="إنتاج داخلي" name="filter_internal" domain="[('is_internal', '=', True)]"/>
                <filter string="تشغيل للغير" name="filter_customer" domain="[('is_internal', '=', False)]"/>
                <group name="group_by">
                    <filter string="نوع النسيج" name="group_type" context="{'group_by': 'weaving_type'}"/>
                    <filter string="الماكينة" name="group_machine" context="{'group_by': 'machine_id'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="صنف القماش" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="الوردية" name="group_shift" context="{'group_by': 'shift'}"/>
                    <filter string="تاريخ الأمر" name="group_date" context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Weaving Order List View -->
    <record id="view_weaving_order_list" model="ir.ui.view">
        <field name="name">thamar.weaving.order.list</field>
        <field name="model">thamar.weaving.order</field>
        <field name="arch" type="xml">
            <list string="أوامر تشغيل النسيج" default_order="order_date desc, id desc">
                <field name="name"/>
                <field name="order_date"/>
                <field name="weaving_type"/>
                <field name="machine_id"/>
                <field name="product_id"/>
                <field name="partner_id" optional="show"/>
                <field name="planned_weight_kg" optional="show"/>
                <field name="total_net_weight_kg" optional="show" sum="إجمالي الوزن الصافي"/>
                <field name="roll_count" optional="show"/>
                <field name="avg_roll_weight_kg" optional="hide"/>
                <field name="waste_percentage" optional="show" widget="percentage"/>
                <field name="operating_hours" optional="hide"/>
                <field name="cost_per_kg" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Weaving Order Form View -->
    <record id="view_weaving_order_form" model="ir.ui.view">
        <field name="name">thamar.weaving.order.form</field>
        <field name="model">thamar.weaving.order</field>
        <field name="arch" type="xml">
            <form string="أمر تشغيل النسيج">
                <header>
                    <button name="action_confirm" string="تأكيد الأمر" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="بدء التشغيل" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_quick_add_roll" string="تنزيل ثوب جديد (سريع)" type="object"
                            class="btn-success" invisible="state not in ['in_progress', 'confirmed']"/>
                    <button name="action_done" string="إنهاء أمر التشغيل" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_draft" string="إعادة للمسودة" type="object"
                            invisible="state not in ['cancel', 'confirmed']"/>
                    <button name="action_cancel" string="إلغاء" type="object"
                            invisible="state in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rolls" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="roll_count" widget="statinfo" string="الأتواب واللوطات"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="بيانات التشغيل الأساسية">
                            <field name="weaving_type" widget="radio"/>
                            <field name="order_date"/>
                            <field name="machine_id" options="{'no_create_edit': True}"/>
                            <field name="product_id" options="{'no_create_edit': True}"/>
                            <field name="is_internal"/>
                            <field name="partner_id" invisible="is_internal" required="not is_internal"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="المواصفات والكميات المخططة">
                            <field name="planned_weight_kg"/>
                            <field name="planned_meter"/>
                            <field name="target_gsm"/>
                            <field name="target_width_cm"/>
                            <!-- حقول إضافية للنسيج الدائري -->
                            <field name="stitch_length_mm" invisible="weaving_type != 'circular'"/>
                            <field name="lycra_percentage" invisible="weaving_type != 'circular'"/>
                            <!-- حقول إضافية للنسيج المستطيل -->
                            <field name="warp_density" invisible="weaving_type != 'rectangular'"/>
                            <field name="weft_density" invisible="weaving_type != 'rectangular'"/>
                            <field name="reed_number" invisible="weaving_type != 'rectangular'"/>
                            <field name="reed_width_used_cm" invisible="weaving_type != 'rectangular'"/>
                            <field name="weave_pattern" invisible="weaving_type != 'rectangular'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="خيوط الغزل ولوطاتها" name="yarn">
                            <field name="yarn_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="yarn_role"/>
                                    <field name="yarn_count"/>
                                    <field name="yarn_lot_id" optional="show"/>
                                    <field name="yarn_lot_name" optional="show"/>
                                    <field name="blend_percentage"/>
                                    <field name="planned_qty_kg" sum="إجمالي المخطط"/>
                                    <field name="consumed_qty_kg" sum="إجمالي المستهلك"/>
                                    <field name="unit_cost" optional="show"/>
                                    <field name="subtotal_cost" sum="الإجمالي"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_yarn_planned_kg"/>
                                <field name="total_yarn_consumed_kg"/>
                                <field name="total_yarn_cost"/>
                            </group>
                        </page>

                        <page string="سجل الأتواب والتتبع باللوط" name="rolls">
                            <div class="mb-3">
                                <button name="action_quick_add_roll" string="+ تنزيل ثوب جديد"
                                        type="object" class="btn btn-primary btn-sm"/>
                            </div>
                            <field name="roll_ids">
                                <list editable="bottom" default_order="date desc, id desc">
                                    <field name="name"/>
                                    <field name="lot_name"/>
                                    <field name="date"/>
                                    <field name="shift"/>
                                    <field name="operator_name" optional="show"/>
                                    <field name="gross_weight_kg"/>
                                    <field name="tare_weight_kg"/>
                                    <field name="net_weight_kg" sum="إجمالي الصافي"/>
                                    <field name="length_meter" sum="إجمالي الأمتار"/>
                                    <field name="measured_gsm" optional="show"/>
                                    <field name="measured_width_cm" optional="show"/>
                                    <field name="grade" widget="badge"
                                           decoration-success="grade == 'grade_a'"
                                           decoration-warning="grade == 'grade_b'"
                                           decoration-danger="grade == 'scrap'"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_create_dyeing_work_order"
                                            string="تحويل لمصبغة" type="object"
                                            icon="fa-tint" title="إنشاء أمر تشغيل طباعة وصباغة لهذا اللوط"
                                            invisible="state == 'delivered_dyeing'"/>
                                </list>
                            </field>
                        </page>

                        <page string="تحليل الجودة والهالك والتكاليف" name="kpis">
                            <group>
                                <group string="تصنيف جودة الأتواب">
                                    <field name="roll_count"/>
                                    <field name="avg_roll_weight_kg"/>
                                    <field name="grade_a_rolls_count"/>
                                    <field name="grade_a_weight_kg"/>
                                    <field name="grade_b_rolls_count"/>
                                    <field name="grade_b_weight_kg"/>
                                    <field name="scrap_rolls_count"/>
                                    <field name="scrap_weight_kg"/>
                                </group>
                                <group string="تحليل الهالك والتكلفة">
                                    <field name="waste_weight_kg"/>
                                    <field name="waste_percentage"/>
                                    <field name="operating_hours"/>
                                    <field name="machine_hourly_cost"/>
                                    <field name="machine_operating_cost"/>
                                    <field name="total_yarn_cost"/>
                                    <field name="total_production_cost" class="oe_subtotal_footer_separator"/>
                                    <field name="cost_per_kg" class="fw-bold fs-5"/>
                                </group>
                            </group>
                        </page>

                        <page string="التشغيل والوردية والملاحظات" name="execution">
                            <group>
                                <group string="مواعيد التشغيل">
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="operating_hours"/>
                                </group>
                                <group string="فريق العمل">
                                    <field name="shift"/>
                                    <field name="supervisor_id"/>
                                    <field name="operator_name"/>
                                </group>
                            </group>
                            <group string="ملاحظات وتوجيهات">
                                <field name="notes" placeholder="ملاحظات العميل، تعليمات الشد والضبط..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Weaving Order Actions -->
    <record id="action_weaving_order_all" model="ir.actions.act_window">
        <field name="name">كل أوامر تشغيل النسيج</field>
        <field name="res_model">thamar.weaving.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_weaving_order_circular" model="ir.actions.act_window">
        <field name="name">أوامر النسيج الدائري</field>
        <field name="res_model">thamar.weaving.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('weaving_type', '=', 'circular')]</field>
        <field name="context">{'default_weaving_type': 'circular'}</field>
    </record>

    <record id="action_weaving_order_rectangular" model="ir.actions.act_window">
        <field name="name">أوامر النسيج المستطيل (الأنوال)</field>
        <field name="res_model">thamar.weaving.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('weaving_type', '=', 'rectangular')]</field>
        <field name="context">{'default_weaving_type': 'rectangular'}</field>
    </record>
</odoo>
