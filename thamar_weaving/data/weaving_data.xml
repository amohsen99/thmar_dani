<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Stop Reasons -->
        <record id="stop_reason_yarn_break" model="thamar.weaving.stop.reason">
            <field name="name">قطع خيط / عيب في الغزل</field>
            <field name="stop_type">yarn_break</field>
            <field name="sequence">10</field>
        </record>

        <record id="stop_reason_needle_break" model="thamar.weaving.stop.reason">
            <field name="name">كسر إبرة / سينكر / جاك</field>
            <field name="stop_type">needle_break</field>
            <field name="sequence">20</field>
        </record>

        <record id="stop_reason_mechanical" model="thamar.weaving.stop.reason">
            <field name="name">عطل ميكانيكي / سير / تروس</field>
            <field name="stop_type">mechanical</field>
            <field name="sequence">30</field>
        </record>

        <record id="stop_reason_electrical" model="thamar.weaving.stop.reason">
            <field name="name">عطل كهربائي / إنفرتر / حساسات</field>
            <field name="stop_type">electrical</field>
            <field name="sequence">40</field>
        </record>

        <record id="stop_reason_setup" model="thamar.weaving.stop.reason">
            <field name="name">تغيير نمرة خيط / ضبط عيار وشد</field>
            <field name="stop_type">setup</field>
            <field name="sequence">50</field>
        </record>

        <record id="stop_reason_maintenance" model="thamar.weaving.stop.reason">
            <field name="name">صيانة وقائية وتزييت ونظافة</field>
            <field name="stop_type">maintenance</field>
            <field name="sequence">60</field>
        </record>

        <record id="stop_reason_shift_change" model="thamar.weaving.stop.reason">
            <field name="name">تسليم واستلام وردية ونظافة الصالة</field>
            <field name="stop_type">shift_change</field>
            <field name="sequence">70</field>
        </record>

        <record id="stop_reason_power_cut" model="thamar.weaving.stop.reason">
            <field name="name">انقطاع تيار كهربائي</field>
            <field name="stop_type">power_cut</field>
            <field name="sequence">80</field>
        </record>
    </data>
</odoo>
