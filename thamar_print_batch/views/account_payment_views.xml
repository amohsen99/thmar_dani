<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--       Extend Payment Form View: Smart Button + Badge         -->
    <!-- ============================================================ -->
    <record id="view_account_payment_form_inherit_print_batch" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.print.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <!-- Header: Add to New Batch button -->
            <xpath expr="//header" position="inside">
                <button name="action_add_to_new_print_batch"
                        string="إضافة إلى مطبوعة جديدة"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft' or print_batch_id"/>
            </xpath>

            <!-- Smart Button: Open linked Print Batch -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_print_batch"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print"
                        invisible="not print_batch_id">
                    <field name="print_batch_name" string="المطبوعة المجمعة" widget="statinfo"/>
                </button>
            </xpath>

            <!-- After payment name: show batch link + printed badge -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="print_batch_id" readonly="1"
                       invisible="not print_batch_id"/>
                <field name="is_printed" invisible="1"/>
                <div invisible="not is_printed" class="mt-1">
                    <span class="badge text-bg-success fs-6">
                        <i class="fa fa-check-circle me-1"/>تمت الطباعة مجمع
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--       Extend Payment List View: Printed Badge Column         -->
    <!-- ============================================================ -->
    <record id="view_account_payment_tree_inherit_print_batch" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.print.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <!-- Header: Action button for bulk adding to batch -->
            <xpath expr="//header" position="inside">
                <button name="action_add_to_new_print_batch"
                        string="إضافة إلى مطبوعة جديدة"
                        type="object"
                        display="always"/>
            </xpath>
            <!-- Add batch serial and printed badge before state column -->
            <field name="state" position="before">
                <field name="print_batch_name" string="Batch #" optional="show"/>
                <field name="is_printed" string="حالة الطباعة" widget="boolean"
                       decoration-success="is_printed"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--       Contextual Server Action: Add to New Print Batch       -->
    <!-- ============================================================ -->
    <record id="action_add_to_new_print_batch" model="ir.actions.server">
        <field name="name">إضافة إلى مطبوعة جديدة (Add to New Print Batch)</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_add_to_new_print_batch()
</field>
    </record>

</odoo>
