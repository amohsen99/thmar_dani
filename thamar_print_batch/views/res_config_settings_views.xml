<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_print_batch" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.print.batch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Print Batch Settings" name="print_batch_setting_container">
                    <setting string="Prevent Deleting Print Batches" help="If checked, users will not be able to delete any print batch records.">
                        <field name="prevent_delete_print_batch"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
