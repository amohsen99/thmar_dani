<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- QWeb Template for Print Batch PDF Report -->
    <template id="report_print_batch_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="font-family: 'DejaVu Sans', 'Arial', sans-serif;">

                        <style>
                            .batch-header {
                                text-align: center;
                                margin: 20px 0 30px 0;
                                padding: 15px;
                                border: 2px solid #2c3e50;
                                border-radius: 8px;
                                background-color: #f8f9fa;
                            }
                            .batch-serial {
                                font-size: 28px;
                                font-weight: 900;
                                color: #2c3e50;
                                letter-spacing: 2px;
                                margin-bottom: 5px;
                            }
                            .batch-title {
                                font-size: 18px;
                                color: #555;
                                margin-top: 5px;
                            }
                            .batch-info-box {
                                background-color: #f0f4f8;
                                border: 1px solid #d1d9e0;
                                border-radius: 6px;
                                padding: 14px 20px;
                                margin-bottom: 25px;
                            }
                            .batch-info-label {
                                font-weight: bold;
                                color: #34495e;
                                display: inline-block;
                                min-width: 120px;
                            }
                            .batch-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 10px;
                            }
                            .batch-table thead th {
                                background-color: #2c3e50;
                                color: #ffffff;
                                padding: 10px 14px;
                                font-weight: bold;
                                border: 1px solid #1a252f;
                                text-align: right;
                                font-size: 13px;
                            }
                            .batch-table tbody td {
                                padding: 9px 14px;
                                border: 1px solid #dee2e6;
                                text-align: right;
                                font-size: 12px;
                            }
                            .batch-table tbody tr:nth-child(even) {
                                background-color: #f8f9fa;
                            }
                            .batch-table tbody tr:hover {
                                background-color: #e9ecef;
                            }
                            .batch-total-row td {
                                font-weight: bold;
                                background-color: #d5e8d4 !important;
                                border-top: 3px solid #2c3e50;
                                padding: 12px 14px;
                                font-size: 14px;
                            }
                            .batch-status {
                                display: inline-block;
                                padding: 3px 12px;
                                border-radius: 12px;
                                font-size: 12px;
                                font-weight: bold;
                            }
                            .batch-status-draft {
                                background-color: #ffeaa7;
                                color: #856404;
                            }
                            .batch-status-posted {
                                background-color: #d4edda;
                                color: #155724;
                            }
                            .batch-barcode {
                                text-align: center;
                                margin: 10px 0;
                            }
                            .batch-signature-section {
                                margin-top: 60px;
                                page-break-inside: avoid;
                            }
                            .batch-signature-box {
                                text-align: center;
                            }
                            .batch-signature-line {
                                border-bottom: 1px solid #333;
                                width: 80%;
                                margin: 40px auto 8px auto;
                            }
                            .batch-signature-label {
                                font-size: 11px;
                                color: #666;
                            }
                        </style>

                        <!-- ==================== Header with Serial ==================== -->
                        <div class="batch-header">
                            <div class="batch-title">
                                <t t-if="o.batch_type == 'inbound'">إيصال استلام</t>
                                <t t-else="">إيصال دفع</t>
                            </div>
                            <div class="batch-serial">
                                <span t-field="o.name"/>
                            </div>
                        </div>

                        <!-- ==================== Batch Info ==================== -->
                        <div class="batch-info-box">
                            <div class="row" style="direction: rtl;">
                                <div class="col-4">
                                    <span class="batch-info-label">التاريخ:</span>
                                    <span t-field="o.date"/>
                                </div>
                                <div class="col-4">
                                    <span class="batch-info-label">
                                        <t t-if="o.batch_type == 'inbound'">استلمنا من:</t>
                                        <t t-else="">صرفنا إلى:</t>
                                    </span>
                                    <span t-field="o.recipient_name"/>
                                </div>
                                <div class="col-4">
                                    <span class="batch-info-label">إجمالي المبلغ:</span>
                                    <strong>
                                        <span t-field="o.total_amount"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="row mt-2" style="direction: rtl;">
                                <div class="col-4">
                                    <span class="batch-info-label">عدد المدفوعات:</span>
                                    <span t-field="o.payment_count"/>
                                </div>
                                <div class="col-4">
                                    <span class="batch-info-label">المورد/العميل:</span>
                                    <span t-field="o.partner_id.name"/>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== Payments Table ==================== -->
                        <h4 style="color: #2c3e50; border-bottom: 2px solid #2c3e50; padding-bottom: 8px; text-align: right;">
                            تفاصيل المدفوعات
                        </h4>
                        <table class="batch-table">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 15%;">التاريخ</th>
                                    <th style="width: 25%;">المرجع / المذكرة</th>
                                    <th style="width: 15%;">رقم الشيك</th>
                                    <th style="width: 15%;">تاريخ الإستحقاق</th>
                                    <th style="width: 10%;">البنك</th>
                                    <th style="width: 15%;">المبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.payment_ids" t-as="pay">
                                    <tr>
                                        <td><span t-esc="pay_index + 1"/></td>
                                        <td><span t-field="pay.date"/></td>
                                        <td><span t-field="pay.memo"/></td>
                                        <td><span t-field="pay.cheque_number"/></td>
                                        <td><span t-field="pay.cheque_due_date"/></td>
                                        <td><span t-field="pay.bank_id"/></td>
                                        <td>
                                            <span t-field="pay.amount"
                                                  t-options="{'widget': 'monetary', 'display_currency': pay.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Total Row -->
                                <tr class="batch-total-row">
                                    <td colspan="6" style="text-align: right;">
                                        <strong>الإجمالي: </strong>

                                    </td>
                                    <td>
                                        <span t-field="o.total_amount"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7" style="text-align: right; background-color: #f8f9fa;">
                                        <strong style="color: #2c3e50;">المبلغ فقط: </strong>
                                        <span t-field="o.amount_in_words" style="font-weight: bold;"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ==================== Signature Section ==================== -->
                        <div class="batch-signature-section">
                            <div class="row">
                                <div class="col-6">
                                    <div class="batch-signature-box">
                                        <strong>أمين الخزينة</strong>
                                        <div class="batch-signature-line"></div>
                                        <div class="batch-signature-label">التوقيع والختم</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="batch-signature-box">
                                        <strong>المستلم</strong>
                                        <div class="batch-signature-line"></div>
                                        <div class="batch-signature-label">التوقيع والختم</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
