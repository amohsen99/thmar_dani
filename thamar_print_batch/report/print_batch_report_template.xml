<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_print_batch_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">

                    <div class="page" dir="rtl" style="font-family: 'DejaVu Sans', 'Arial', sans-serif; font-size: 15px; color: #2c3e50; line-height: 1.5; padding: 5px;">

                        <style>
                            * {
                                box-sizing: border-box;
                            }
                            .page {
                                padding: 0 !important;
                                margin: 0 !important;
                                width: 100%;
                            }
                            .header-table {
                                width: 100%;
                                border-collapse: collapse;
                                border-bottom: 3px solid #2c3e50;
                                margin-bottom: 15px;
                            }
                            .header-table td {
                                padding: 8px;
                                border: none;
                                vertical-align: middle;
                            }
                            .header-logo {
                                max-height: 65px;
                                max-width: 150px;
                                display: block;
                                margin-bottom: 5px;
                            }
                            .company-title {
                                font-size: 18px;
                                font-weight: 900;
                                color: #2c3e50;
                                margin: 4px 0;
                            }
                            .company-details-text {
                                font-size: 12px;
                                color: #555;
                                margin: 2px 0;
                            }
                            .batch-title-text {
                                font-size: 20px;
                                font-weight: bold;
                                color: #2c3e50;
                                margin-bottom: 5px;
                            }
                            .batch-serial-text {
                                font-size: 20px;
                                font-weight: 900;
                                color: #e74c3c;
                                letter-spacing: 0.5px;
                            }
                            .info-table {
                                width: 100%;
                                border-collapse: collapse;
                                background-color: #f8f9fa;
                                border: 1px solid #dee2e6;
                                border-radius: 6px;
                                margin-bottom: 15px;
                            }
                            .info-table td {
                                padding: 10px 12px;
                                border: none;
                                font-size: 15px;
                                vertical-align: middle;
                                white-space: normal;
                                word-wrap: break-word;
                            }
                            .info-label {
                                font-weight: bold;
                                color: #34495e;
                                padding-right: 40px;
                            }
                            .info-value {
                                color: #000;
                            }
                            .section-title {
                                color: #2c3e50;
                                border-bottom: 2px solid #2c3e50;
                                padding-bottom: 5px;
                                text-align: right;
                                font-size: 16px;
                                margin: 15px 0 10px 0;
                                font-weight: bold;
                            }
                            .batch-table {
                                width: 100%;
                                border-collapse: collapse;
                                table-layout: fixed;
                                margin-top: 5px;
                            }
                            .batch-table thead th {
                                background-color: #2c3e50;
                                color: #fff;
                                padding: 10px 6px;
                                font-weight: bold;
                                border: 1px solid #1a252f;
                                text-align: center;
                                font-size: 14px;
                                white-space: normal;
                                word-wrap: break-word;
                            }
                            .batch-table tbody td {
                                padding: 5px 3px;
                                border: 1px solid #dee2e6;
                                text-align: center;
                                font-size: 12px;
                                white-space: normal;
                                word-wrap: break-word;
                                overflow-wrap: break-word;
                                vertical-align: middle;
                            }
                            .batch-table tbody tr:nth-child(even) {
                                background-color: #f8f9fa;
                            }
                            .batch-total-row td {
                                font-weight: bold;
                                background-color: #e2f0d9 !important;
                                border-top: 2px solid #2c3e50;
                                border-bottom: 1px solid #dee2e6;
                                padding: 12px 10px;
                                font-size: 15px;
                                color: #1e4620;
                            }
                            .amount-words-row td {
                                background-color: #f2f4f4 !important;
                                padding: 12px 10px;
                                font-size: 15px;
                                white-space: normal;
                                word-wrap: break-word;
                                border-bottom: 2px solid #2c3e50;
                            }
                            .sig-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 30px;
                                page-break-inside: avoid;
                            }
                            .sig-table td {
                                width: 50%;
                                border: none;
                                text-align: center;
                                padding: 0 15px;
                                vertical-align: top;
                            }
                            .sig-line {
                                border-bottom: 1px dashed #7f8c8d;
                                width: 85%;
                                margin: 30px auto 6px auto;
                            }
                            .sig-label {
                                font-size: 12px;
                                color: #7f8c8d;
                            }
                            .batch-footer {
                                border-top: 1px solid #dee2e6;
                                margin-top: 25px;
                                padding-top: 5px;
                                text-align: center;
                                font-size: 11px;
                                color: #7f8c8d;
                            }
                        </style>

                        <table class="header-table">
                            <tr>
                                <td style="width: 50%; text-align: right;">
                                    <t t-if="o.company_id.logo">
                                        <img t-att-src="image_data_uri(o.company_id.logo)" class="header-logo" alt="Logo"/>
                                    </t>
                                    <div class="company-title">
                                        <t t-esc="o.company_id.name"/>
                                    </div>
                                    <div t-if="o.company_id.phone" class="company-details-text">
                                        هاتف: <t t-esc="o.company_id.phone"/>
                                        <t t-if="o.company_id.email"> | <t t-esc="o.company_id.email"/></t>
                                    </div>
                                    <div t-if="o.company_id.vat" class="company-details-text">
                                        الرقم الضريبي: <t t-esc="o.company_id.vat"/>
                                    </div>
                                </td>
                                <td style="width: 50%; text-align: left; vertical-align: middle;">
                                    <div class="batch-title-text">
                                        <t t-if="o.batch_type == 'inbound'">إيصال استلام نقدي</t>
                                        <t t-else="">إيصال صرف نقدي</t>
                                    </div>
                                    <div class="batch-serial-text">
                                        الرقم: <span t-field="o.name"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="info-table">
                            <tr>
                                <td style="width: 50%;">
                                    <span class="info-label">التاريخ:</span>
                                    <span class="info-value" t-field="o.date" t-options='{"widget": "date"}'/>
                                </td>
                                <td style="width: 50%;">
                                    <span class="info-label">
                                        <t t-if="o.batch_type == 'inbound'">استلمنا من:</t>
                                        <t t-else="">صرفنا إلى:</t>
                                    </span>
                                    <span class="info-value" t-field="o.recipient_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 50%;">
                                    <span class="info-label">إجمالي المبلغ:</span>
                                    <strong class="info-value">
                                        <span t-field="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </strong>
                                </td>
                                <td style="width: 50%;">
                                    <span class="info-label">عدد الحركات:</span>
                                    <span class="info-value" t-field="o.payment_count"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <span class="info-label">المورد / العميل:</span>
                                    <span class="info-value" t-field="o.partner_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <div class="section-title">تفاصيل الدفعات والمسيرات</div>
                        <table class="batch-table">
                            <thead>
                                <tr>
                                    <th style="width: 6%;">#</th>
                                    <th style="width: 14%;">التاريخ</th>
                                    <th style="width: 24%;">البيان / المذكرة</th>
                                    <th style="width: 14%;">رقم الشيك</th>
                                    <th style="width: 14%;">الاستحقاق</th>
                                    <th style="width: 14%;">البنك</th>
                                    <th style="width: 14%;">المبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.payment_ids" t-as="pay">
                                    <tr>
                                        <td><span t-esc="pay_index + 1"/></td>
                                        <td><span t-field="pay.date" t-options='{"widget": "date"}'/></td>
                                        <td style="text-align: right;"><span t-field="pay.memo"/></td>
                                        <td><span t-field="pay.cheque_number"/></td>
                                        <td><span t-field="pay.cheque_due_date" t-options='{"widget": "date"}'/></td>
                                        <td><span t-field="pay.bank_id"/></td>
                                        <td style="text-align: left; font-weight: bold;">
                                            <span t-field="pay.amount" t-options="{'widget': 'monetary', 'display_currency': pay.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>

                                <tr class="batch-total-row">
                                    <td colspan="6" style="text-align: left;">
                                        <strong>المجموع الكلي:</strong>
                                    </td>
                                    <td style="text-align: left;">
                                        <span t-field="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="amount-words-row">
                                    <td colspan="7" style="text-align: right;">
                                        <span class="info-label" style="color: #2c3e50;">فقط وقدره: </span>
                                        <span t-field="o.amount_in_words" style="font-weight: bold; color: #000;"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="sig-table">
                            <tr>
                                <td>
                                    <strong style="font-size: 14px;">توقيع أمين الصندوق</strong>
                                    <div class="sig-line"></div>
                                    <div class="sig-label">الاسم والتوقيع الرسمي</div>
                                </td>
                                <td>
                                    <strong style="font-size: 14px;">توقيع المستلم</strong>
                                    <div class="sig-line"></div>
                                    <div class="sig-label">الاسم والتوقيع الرسمي</div>
                                </td>
                            </tr>
                        </table>

                        <div class="batch-footer">
                            <t t-esc="o.company_id.name"/>
                            <t t-if="o.company_id.phone"> | هاتف: <t t-esc="o.company_id.phone"/></t>
                            <t t-if="o.company_id.website"> | <t t-esc="o.company_id.website"/></t>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>