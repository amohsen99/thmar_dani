<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Inbound Print Batch -->
        <record id="seq_account_print_batch_inbound" model="ir.sequence">
            <field name="name">Payment Print Batch Inbound</field>
            <field name="code">account.print.batch.inbound</field>
            <field name="prefix">PRNT/IN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sequence for Outbound Print Batch -->
        <record id="seq_account_print_batch_outbound" model="ir.sequence">
            <field name="name">Payment Print Batch Outbound</field>
            <field name="code">account.print.batch.outbound</field>
            <field name="prefix">PRNT/OUT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
