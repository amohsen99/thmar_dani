<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_template" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.template</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="before">
                <page string="Operation Selection" name="operation_selection" invisible="state != 'draft'">
                    <group>
                        <group>
                            <field name="operation_template_ids" widget="many2many_tags" 
                                   options="{'no_create': True}"
                                   placeholder="Select standard operations..."/>
                        </group>
                        <group>
                            <button name="action_apply_operation_templates"
                                    type="object"
                                    string="Apply Operations"
                                    class="btn-primary"
                                    confirm="This will create work orders and quality checks based on the selected templates. Proceed?"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-2" role="alert">
                        Select templates and click <b>Apply Operations</b> to automatically build your production plan for this MO.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
