# ========================
# 1. ODOO SPECIFIC FILES
# ========================

# The Odoo server log file
odoo.log

# Odoo's default filestore (where attachments and binary fields are stored)
# CRITICAL: If you use the default Odoo installation, ignore this.
# If your database is named differently, update the folder name accordingly.
.local/share/Odoo/filestore
.local/share/Odoo/sessions
/filestore/

# Translation files generated by Odoo
# *.po
# *.pot

# Cache directories for Odoo server
.cache/

# ========================
# 2. PYTHON COMPILED FILES
# ========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ========================
# 3. ENVIRONMENT AND PACKAGING
# ========================

# Virtual environments
.env
/env/
/venv/
Venv/

# Distribution / packaging
/build/
/dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.coverage
.coverage.*
/htmlcov/
nosetests.xml
coverage.xml
.tox/

# ========================
# 4. EDITOR/IDE FILES (Common)
# ========================

# Visual Studio Code
.vscode/

# PyCharm
.idea/

# Vim/Nano swap files
*~
*.swp

# macOS files
.DS_Store

# ========================
# 5. CUSTOM ADDONS SPECIFIC
# ========================

# If you have an 'extra-addons' folder or similar that holds
# Odoo core/community modules cloned from elsewhere,
# you should ignore that folder in your custom repository.
# e.g., if you clone the OCA modules:
# /oca_addons/