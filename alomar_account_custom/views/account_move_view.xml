<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add custom fields to Invoice/Bill form view -->
    <record id="view_move_form_inherit_alomar" model="ir.ui.view">
        <field name="name">account.move.form.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="invoice_type"/>
                <field name="permission_number"/>
                <field name="warehouse_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add custom fields to Customer Invoices list view -->
    <record id="view_out_invoice_tree_inherit_alomar" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="invoice_type"/>
                <field name="permission_number"/>
                <field name="warehouse_id"/>
            </field>
        </field>
    </record>

    <!-- Add custom fields to Vendor Bills list view -->
    <record id="view_in_invoice_bill_tree_inherit_alomar" model="ir.ui.view">
        <field name="name">account.in.invoice.bill.tree.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="invoice_type"/>
                <field name="permission_number"/>
                <field name="warehouse_id"/>
            </field>
        </field>
    </record>

    <!-- Add search fields, quick filters, date range filters, and group by to Invoice search view -->
    <record id="view_invoice_search_inherit_alomar" model="ir.ui.view">
        <field name="name">account.invoice.search.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_type" string="نوع الفاتورة"/>
                <field name="permission_number" string="رقم الاذن"/>
                <field name="warehouse_id" string="المخزن"/>
            </xpath>

            <xpath expr="//filter[@name='invoice_date']" position="after">
                <filter
                    name="invoice_type_cash"
                    string="كاش"
                    domain="[('invoice_type', '=', 'cash')]"/>
                <filter
                    name="invoice_type_credit"
                    string="اجل"
                    domain="[('invoice_type', '=', 'credit')]"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter
                    name="group_by_invoice_type"
                    string="تجميع حسب نوع الفاتورة"
                    context="{'group_by': 'invoice_type'}"/>
                <filter
                    name="group_by_warehouse"
                    string="تجميع حسب المخزن"
                    context="{'group_by': 'warehouse_id'}"/>
                <separator/>
                <filter
                    name="group_by_invoice_date"
                    string="تجميع حسب تاريخ الفاتورة"
                    context="{'group_by': 'invoice_date'}"/>
            </xpath>
        </field>
    </record>

    <!-- Add search fields, quick filters, date range filters, and group by to Bill search view -->
    <record id="view_bill_search_inherit_alomar" model="ir.ui.view">
        <field name="name">account.bill.search.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_type" string="نوع الفاتورة"/>
                <field name="permission_number" string="رقم الاذن"/>
                <field name="warehouse_id" string="المخزن"/>
            </xpath>

            <xpath expr="//filter[@name='invoice_date']" position="after">
                <filter
                    name="invoice_type_cash"
                    string="كاش"
                    domain="[('invoice_type', '=', 'cash')]"/>
                <filter
                    name="invoice_type_credit"
                    string="اجل"
                    domain="[('invoice_type', '=', 'credit')]"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter
                    name="group_by_invoice_type"
                    string="تجميع حسب نوع الفاتورة"
                    context="{'group_by': 'invoice_type'}"/>
                <filter
                    name="group_by_warehouse"
                    string="تجميع حسب المخزن"
                    context="{'group_by': 'warehouse_id'}"/>
                <separator/>
                <filter
                    name="group_by_invoice_date"
                    string="تجميع حسب تاريخ الفاتورة"
                    context="{'group_by': 'invoice_date'}"/>
            </xpath>
        </field>
    </record>
</odoo>
