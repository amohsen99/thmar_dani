<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add custom fields to Invoice/Bill form view -->
    <record id="view_move_form_inherit_alomar" model="ir.ui.view">
        <field name="name">account.move.form.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="invoice_type"/>
                <field name="permission_number"/>
                <field name="warehouse_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add custom fields to Invoice/Bill list view -->
    <record id="view_move_tree_inherit_alomar" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="invoice_type"/>
                <field name="permission_number"/>
                <field name="warehouse_id"/>
            </field>
        </field>
    </record>

    <!-- Add search fields and quick filters -->
    <record id="view_move_search_inherit_alomar" model="ir.ui.view">
        <field name="name">account.move.search.inherit.alomar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_type" string="نوع الفاتورة"/>
                <field name="permission_number" string="رقم الاذن"/>
                <field name="warehouse_id" string="المخزن"/>
            </xpath>

            <xpath expr="//filter[@name='invoice_date']" position="after">
                <filter
                    name="invoice_type_cash"
                    string="كاش"
                    domain="[('invoice_type', '=', 'cash')]"/>
                <filter
                    name="invoice_type_credit"
                    string="اجل"
                    domain="[('invoice_type', '=', 'credit')]"/>
            </xpath>
        </field>
    </record>
</odoo>
