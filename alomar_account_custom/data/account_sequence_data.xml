<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_invoice" model="ir.sequence">
            <field name="name">Invoice Sequence</field>
            <field name="code">account.move.invoice</field>
            <field name="prefix">INV/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_bill" model="ir.sequence">
            <field name="name">Bill Sequence</field>
            <field name="code">account.move.bill</field>
            <field name="prefix">BILL/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
