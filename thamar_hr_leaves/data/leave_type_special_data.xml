            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">24</field>
            <field name="color">6</field>
        </record>
        <record id="leave_type_newborn_paid" model="hr.leave.type">
            <field name="name">إجازة مولود - يوم مدفوع الأجر</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">25</field>
            <field name="color">7</field>
        </record>
        <record id="leave_type_exams" model="hr.leave.type">
            <field name="name">إجازة امتحانات</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">26</field>
            <field name="color">9</field>
        </record>
    </data>
</odoo>
