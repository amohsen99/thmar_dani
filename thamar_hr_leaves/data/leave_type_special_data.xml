<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Canonical Thamar special leave types.  They deliberately do not
         require allocations, so employees can submit them immediately. -->
    <data noupdate="1">
        <record id="leave_type_work_injury" model="hr.leave.type">
            <field name="name">إجازة إصابة العمل</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">20</field>
            <field name="color">1</field>
        </record>
        <record id="leave_type_sick" model="hr.leave.type">
            <field name="name">إجازات مرضية</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">21</field>
            <field name="color">3</field>
        </record>
        <record id="leave_type_unpaid" model="hr.leave.type">
            <field name="name">إجازات بدون أجر</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">22</field>
            <field name="color">8</field>
        </record>
        <record id="leave_type_marriage_paid" model="hr.leave.type">
            <field name="name">إجازة زواج - 7 أيام مدفوعة الأجر</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
            <field name="leave_validation_type">hr</field>
            <field name="request_unit">day</field>
            <field name="time_type">leave</field>
            <field name="sequence">23</field>
            <field name="color">5</field>
        </record>
        <record id="leave_type_death_paid" model="hr.leave.type">
            <field name="name">إجازة وفاة - 3 أيام مدفوعة الأجر</field>
            <field name="requires_allocation" eval="False"/>
            <field name="employee_requests" eval="True"/>
