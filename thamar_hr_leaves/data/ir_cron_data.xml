<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Yearly Leave Recompute Cron Job                        -->
        <!-- Runs annually on Jan 1st to:                           -->
        <!--   1. Create casual leave (7 days; prorated for new hires) -->
        <!--   2. Recompute annual entitlements (age, experience)   -->
        <!--   3. Carry over remaining annual leave balance         -->
        <!--   4. Generate new annual allocations                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <record id="ir_cron_yearly_leave_recompute" model="ir.cron">
            <field name="name">Thamar: Yearly Leave Recompute (Jan 1st)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="state">code</field>
            <field name="code">model._cron_yearly_leave_recompute()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall">2027-01-01 00:00:00</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
