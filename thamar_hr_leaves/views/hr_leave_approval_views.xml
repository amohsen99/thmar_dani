<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="hr_leave_view_tree_inherit_department" model="ir.ui.view"><field name="name">hr.leave.view.tree.inherit.department</field><field name="model">hr.leave</field><field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/><field name="arch" type="xml">
<xpath expr="//header/button[@name='action_approve']" position="attributes"><attribute name="groups">hr_holidays.group_hr_holidays_user</attribute></xpath><xpath expr="//header/button[@name='action_refuse']" position="attributes"><attribute name="groups">hr_holidays.group_hr_holidays_user</attribute></xpath></field></record>
 <record id="hr_leave_view_form_inherit_supervisor" model="ir.ui.view"><field name="name">hr.leave.view.form.inherit.supervisor</field><field name="model">hr.leave</field><field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/><field name="arch" type="xml">
<xpath expr="//header" position="inside"><field name="can_supervisor_approve" invisible="1"/><field name="department_supervisor_id" invisible="1"/><field name="supervisor_approved" invisible="1"/><field name="can_manager_approve" invisible="1"/><field name="department_manager_id" invisible="1"/><field name="manager_approved" invisible="1"/><field name="requires_clinical_approval" invisible="1"/><field name="can_clinical_approve" invisible="1"/><field name="clinical_approved" invisible="1"/><field name="accrual_limit_override" invisible="1"/><button string="Supervisor Approve" name="action_supervisor_approve" type="object" class="btn-primary" invisible="not can_supervisor_approve"/><button string="Supervisor Refuse" name="action_supervisor_refuse" type="object" class="btn-secondary" invisible="not can_supervisor_approve"/><button string="Manager Approve" name="action_manager_approve" type="object" class="btn-primary" invisible="not can_manager_approve"/><button string="Manager Refuse" name="action_manager_refuse" type="object" class="btn-secondary" invisible="not can_manager_approve"/><button string="Clinical Approve" name="action_clinical_approve" type="object" class="btn-primary" invisible="not can_clinical_approve"/><button string="Clinical Refuse" name="action_clinical_refuse" type="object" class="btn-secondary" invisible="not can_clinical_approve"/></xpath><xpath expr="//field[@name='holiday_status_id']" position="after"><field name="department_supervisor_id" widget="many2one_avatar_employee" invisible="not department_supervisor_id"/><field name="supervisor_approved" readonly="1" groups="hr_holidays.group_hr_holidays_user" invisible="not department_supervisor_id"/><field name="department_manager_id" widget="many2one_avatar_employee" invisible="not department_manager_id"/><field name="manager_approved" readonly="1" groups="hr_holidays.group_hr_holidays_user" invisible="not department_manager_id"/><field name="clinical_approved" readonly="1" groups="hr_holidays.group_hr_holidays_user" invisible="not requires_clinical_approval"/><field name="accrual_limit_override" groups="hr_holidays.group_hr_holidays_user"/></xpath></field></record>
 <record id="hr_leave_view_search_inherit_clinical" model="ir.ui.view"><field name="name">hr.leave.view.search.inherit.clinical</field><field name="model">hr.leave</field><field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/><field name="arch" type="xml">
<xpath expr="//filter[@name='to_approve']" position="after"><filter string="Pending Clinical Approval" name="pending_clinical_approval" domain="[('requires_clinical_approval', '=', True), ('clinical_approved', '=', False), ('state', '=', 'validate1')]" groups="thamar_hr_leaves.group_hr_holidays_clinical_manager"/></xpath></field></record>
 <record id="hr_leave_action_clinical_approval" model="ir.actions.act_window"><field name="name">Clinical Approvals</field><field name="res_model">hr.leave</field><field name="view_mode">list,form</field><field name="domain">[('requires_clinical_approval', '=', True), ('clinical_approved', '=', False), ('state', '=', 'validate1')]</field><field name="search_view_id" ref="hr_holidays.view_hr_holidays_filter"/></record>
 <menuitem id="menu_hr_holidays_clinical_approval" name="Clinical Approvals" parent="hr_holidays.menu_hr_holidays_root" action="hr_leave_action_clinical_approval" groups="thamar_hr_leaves.group_hr_holidays_clinical_manager" sequence="3"/>
 <record id="hr_leave_action_department_leaves" model="ir.actions.act_window"><field name="name">Department Time Off</field><field name="res_model">hr.leave</field><field name="view_mode">list,form,kanban,activity</field><field name="search_view_id" ref="hr_holidays.view_hr_holidays_filter"/><field name="domain">['|', ('department_id.manager_id.user_id', '=', uid), ('department_id.supervisor_id.user_id', '=', uid)]</field><field name="context">{'hide_employee_name': 0}</field></record>
 <menuitem id="menu_hr_leave_department_leaves" name="Department Time Off" parent="hr_holidays.menu_hr_holidays_root" action="hr_leave_action_department_leaves" groups="thamar_hr_leaves.group_hr_holidays_department_supervisor,thamar_hr_leaves.group_hr_holidays_department_manager" sequence="4"/>
</odoo>
