<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_cost_center_list" model="ir.ui.view">
    <field name="name">factory.cost.center.list</field>
    <field name="model">factory.cost.center</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="kind"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_factory_cost_center_form" model="ir.ui.view">
    <field name="name">factory.cost.center.form</field>
    <field name="model">factory.cost.center</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="code"/>
            <field name="kind"/>
            <field name="company_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_cost_center" model="ir.actions.act_window">
    <field name="name">الأقسام ومراكز التكلفة</field>
    <field name="res_model">factory.cost.center</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
