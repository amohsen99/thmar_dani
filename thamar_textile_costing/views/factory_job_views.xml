<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_job_list" model="ir.ui.view">
    <field name="name">factory.job.list</field>
    <field name="model">factory.job</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="fabric_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_factory_job_form" model="ir.ui.view">
    <field name="name">factory.job.form</field>
    <field name="model">factory.job</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="date"/>
            <field name="partner_id"/>
            <field name="fabric_id"/>
            <field name="company_id"/>
          </group>
          <field name="batch_ids" readonly="1">
            <list>
              <field name="name"/>
              <field name="date"/>
              <field name="color_id"/>
              <field name="total_cost"/>
              <field name="state"/>
            </list>
          </field>
          <field name="notes"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_job" model="ir.actions.act_window">
    <field name="name">أوامر الشغل</field>
    <field name="res_model">factory.job</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
