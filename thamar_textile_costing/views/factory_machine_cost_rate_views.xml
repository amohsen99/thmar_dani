<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_machine_cost_rate_list" model="ir.ui.view">
    <field name="name">factory.machine.cost.rate.list</field>
    <field name="model">factory.machine.cost.rate</field>
    <field name="arch" type="xml">
      <list>
        <field name="machine_id"/>
        <field name="month"/>
        <field name="method"/>
        <field name="hourly_rate"/>
        <field name="state"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_factory_machine_cost_rate_form" model="ir.ui.view">
    <field name="name">factory.machine.cost.rate.form</field>
    <field name="model">factory.machine.cost.rate</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_approve" type="object" string="اعتماد السعر" class="oe_highlight" invisible="state != 'draft'" groups="thamar_textile_costing.group_manager"/>
          <button name="action_draft" type="object" string="إعادة إلى مسودة" invisible="state != 'approved'" groups="thamar_textile_costing.group_manager"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group col="4">
            <field name="machine_id" readonly="state == 'approved'"/>
            <field name="month" readonly="state == 'approved'"/>
            <field name="company_id" readonly="state == 'approved'"/>
            <field name="method" readonly="state == 'approved'"/>
            <field name="currency_id" invisible="1"/>
            <field name="manual_rate" invisible="method != 'manual'" readonly="state == 'approved'"/>
            <field name="idle_percent" readonly="state == 'approved'"/>
            <field name="base_rate"/>
            <field name="hourly_rate"/>
          </group>
          <field name="line_ids" invisible="method != 'detail'" readonly="state == 'approved'">
            <list editable="bottom">
              <field name="category_id"/>
              <field name="method"/>
              <field name="fixed_amount"/>
              <field name="consumption"/>
              <field name="unit_label"/>
              <field name="unit_price"/>
              <field name="period_amount"/>
              <field name="allocation_percent"/>
              <field name="period_hours"/>
              <field name="amount" sum="الإجمالي"/>
              <field name="notes" optional="hide"/>
            </list>
          </field>
          <field name="notes" readonly="state == 'approved'"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_machine_cost_rate" model="ir.actions.act_window">
    <field name="name">أسعار الساعة الشهرية</field>
    <field name="res_model">factory.machine.cost.rate</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
