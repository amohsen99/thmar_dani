<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_operation_list" model="ir.ui.view">
    <field name="name">factory.operation.list</field>
    <field name="model">factory.operation</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="kind"/>
      </list>
    </field>
  </record>
  <record id="view_factory_operation_form" model="ir.ui.view">
    <field name="name">factory.operation.form</field>
    <field name="model">factory.operation</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="kind"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_operation" model="ir.actions.act_window">
    <field name="name">مراحل التشغيل</field>
    <field name="res_model">factory.operation</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
