<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_cost_category_list" model="ir.ui.view">
    <field name="name">factory.cost.category.list</field>
    <field name="model">factory.cost.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
      </list>
    </field>
  </record>
  <record id="view_factory_cost_category_form" model="ir.ui.view">
    <field name="name">factory.cost.category.form</field>
    <field name="model">factory.cost.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="code"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_cost_category" model="ir.actions.act_window">
    <field name="name">بنود التكلفة</field>
    <field name="res_model">factory.cost.category</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
