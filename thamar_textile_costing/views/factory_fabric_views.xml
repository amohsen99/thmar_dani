<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_fabric_list" model="ir.ui.view">
    <field name="name">factory.fabric.list</field>
    <field name="model">factory.fabric</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="product_id"/>
        <field name="meters_per_kg"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_factory_fabric_form" model="ir.ui.view">
    <field name="name">factory.fabric.form</field>
    <field name="model">factory.fabric</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="product_id"/>
            <field name="meters_per_kg"/>
            <field name="company_id"/>
          </group>
          <field name="speed_ids">
            <list editable="bottom">
              <field name="operation_id"/>
              <field name="machine_id"/>
              <field name="meters_per_minute"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_fabric" model="ir.actions.act_window">
    <field name="name">أصناف القماش</field>
    <field name="res_model">factory.fabric</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
