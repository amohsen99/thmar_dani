<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_factory_machine_list" model="ir.ui.view">
    <field name="name">factory.machine.list</field>
    <field name="model">factory.machine</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="center_id"/>
        <field name="min_capacity"/>
        <field name="max_capacity"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_factory_machine_form" model="ir.ui.view">
    <field name="name">factory.machine.form</field>
    <field name="model">factory.machine</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="name"/>
            <field name="code"/>
            <field name="center_id"/>
            <field name="min_capacity"/>
            <field name="max_capacity"/>
            <field name="company_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_factory_machine" model="ir.actions.act_window">
    <field name="name">الماكينات</field>
    <field name="res_model">factory.machine</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
