<record id="rule_factory_fabric_speed" model="ir.rule"><field name="name">factory.fabric.speed: company</field><field name="model_id" ref="model_factory_fabric_speed"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_factory_machine_cost_rate" model="ir.rule"><field name="name">factory.machine.cost.rate: company</field><field name="model_id" ref="model_factory_machine_cost_rate"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
