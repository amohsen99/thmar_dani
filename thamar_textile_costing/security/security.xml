<odoo>
<record id="group_user" model="res.groups"><field name="name">مستخدم تكاليف المصنع</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
<record id="group_manager" model="res.groups"><field name="name">مدير تكاليف المصنع</field><field name="implied_ids" eval="[(4, ref('group_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_admin'))]"/></record>
<record id="rule_factory_cost_center" model="ir.rule"><field name="name">factory.cost.center: company</field><field name="model_id" ref="model_factory_cost_center"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_factory_machine" model="ir.rule"><field name="name">factory.machine: company</field><field name="model_id" ref="model_factory_machine"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
