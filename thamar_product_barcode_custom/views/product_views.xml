<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_thamar_barcode" model="ir.ui.view">
        <field name="name">product.template.form.thamar.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="attributes">
                <attribute name="context">{'hierarchical_naming': False}</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </field>
            <field name="categ_id" position="after">
                <field name="thamar_barcode_mode" invisible="1"/>
                <field name="thamar_barcode_preview"
                       readonly="1"
                       invisible="thamar_barcode_mode == 'none'"/>
                <button name="action_generate_thamar_category_barcodes"
                        type="object"
                        string="توليد الأكواد الناقصة"
                        class="btn-secondary"
                        invisible="thamar_barcode_mode == 'none'"/>
            </field>
        </field>
    </record>

    <record id="product_product_form_view_thamar_barcode" model="ir.ui.view">
        <field name="name">product.product.form.thamar.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="thamar_barcode_category_id"
                       readonly="1"
                       invisible="not thamar_barcode_category_id"/>
                <field name="thamar_barcode_serial"
                       readonly="1"
                       invisible="not thamar_barcode_serial"/>
            </field>
        </field>
    </record>

    <record id="product_product_list_view_thamar_barcode" model="ir.ui.view">
        <field name="name">product.product.list.thamar.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="thamar_barcode_category_id" optional="hide"/>
                <field name="thamar_barcode_serial" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
