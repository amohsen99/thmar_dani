<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_cheque_management" model="ir.module.category">
            <field name="name">Cheque Management / إدارة الشيكات</field>
            <field name="description">Manage cheques lifecycle, batches, endorsement, and portfolios</field>
            <field name="sequence">110</field>
            <field name="parent_id" ref="base.module_category_accounting_accounting"/>
        </record>

        <!-- Privilege Layer (Required in Odoo 19) -->
        <record id="res_groups_privilege_cheque" model="res.groups.privilege">
            <field name="name">Cheques / الشيكات</field>
            <field name="category_id" ref="module_category_cheque_management"/>
            <field name="sequence">10</field>
        </record>

        <!-- User Group -->
        <record id="group_check_user" model="res.groups">
            <field name="name">User / مستخدم الشيكات</field>
            <field name="privilege_id" ref="res_groups_privilege_cheque"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Can view, create and process check batches and checks.</field>
        </record>

        <!-- Manager Group -->
        <record id="group_check_manager" model="res.groups">
            <field name="name">Manager / مدير الشيكات</field>
            <field name="privilege_id" ref="res_groups_privilege_cheque"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_check_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="comment">Full access to manage, cancel, and configure cheque accounts and batches.</field>
        </record>

        <!-- Multi-Company Rules -->
        <record id="check_comp_rule" model="ir.rule">
            <field name="name">Account Check multi-company</field>
            <field name="model_id" ref="model_account_check"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="check_batch_comp_rule" model="ir.rule">
            <field name="name">Check Batch multi-company</field>
            <field name="model_id" ref="model_check_batch"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="check_storage_drawer_comp_rule" model="ir.rule">
            <field name="name">Check Drawer multi-company</field>
            <field name="model_id" ref="model_check_storage_drawer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
