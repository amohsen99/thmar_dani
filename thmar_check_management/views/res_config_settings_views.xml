<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit res.config.settings to add Cheque Management default accounts -->
        <record id="res_config_settings_view_form_inherit_check" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.check</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Cheques / الشيكات" string="Cheques / الشيكات" name="thmar_check_management">
                        <block title="Cheque Journal &amp; Default Accounts / حسابات دورة الشيكات الافتراضية" id="cheque_accounts_setting_container">

                            <setting id="check_journal_setting"
                                     help="The default accounting journal for cheque transactions and clearing entries.">
                                <field name="check_journal_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_receivable_account_setting"
                                     help="Notes Receivable Account for checks in the safe / drawer (أوراق قبض - شيكات بالخزينة).">
                                <field name="check_receivable_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_under_collection_account_setting"
                                     help="Account for checks deposited into banks under collection (شيكات برسم التحصيل).">
                                <field name="check_under_collection_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_endorsed_account_setting"
                                     help="Clearing intermediate account for checks endorsed to suppliers or customers (تسوية الشيكات المظهرة).">
                                <field name="check_endorsed_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_bounced_account_setting"
                                     help="Account for bounced or returned checks (شيكات مرتدة أو مرفوضة).">
                                <field name="check_bounced_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_payable_account_setting"
                                     help="Notes Payable Account for outgoing checks issued by the factory to vendors (أوراق دفع - شيكات صادرة).">
                                <field name="check_payable_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                            <setting id="check_discount_expense_account_setting"
                                     help="Expense account for discounting interest and bank commission (مصاريف وفوائد خصم الشيكات).">
                                <field name="check_discount_expense_account_id" options="{'no_create_edit': True}"/>
                            </setting>

                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_check_config" model="ir.actions.act_window">
            <field name="name">Cheque Settings / إعدادات الشيكات</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module': 'thmar_check_management'}</field>
        </record>

    </data>
</odoo>
