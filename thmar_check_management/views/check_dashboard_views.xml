<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             Cheque Management Dashboard Form View
        ============================================================ -->
        <record id="view_check_dashboard_form" model="ir.ui.view">
            <field name="name">check.dashboard.form</field>
            <field name="model">check.dashboard</field>
            <field name="arch" type="xml">
                <form string="Cheques Dashboard / لوحة مؤشرات دورة الشيكات" create="0" delete="0" edit="0">
                    <sheet>
                        <!-- Quick Actions Bar -->
                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4 p-3 bg-light rounded border">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-tachometer fa-2x text-primary" title="Dashboard"/>
                                <div>
                                    <h3 class="m-0 fw-bold">لوحة متابعة ومؤشرات الشيكات</h3>
                                    <span class="text-muted small">إحصائيات فورية وتتبع لحالات الشيكات ومواقعها</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button name="action_create_inward_batch" string="＋ استلام حافظة شيكات واردة" type="object" class="btn btn-primary"/>
                                <button name="action_create_outward_batch" string="＋ صرف وتظهير شيكات لمورد/عميل" type="object" class="btn btn-warning"/>
                                <button name="action_view_all" string="عرض جميع الشيكات" type="object" class="btn btn-outline-secondary"/>
                            </div>
                        </div>

                        <!-- Top Stat Cards (Row 1: Primary States) -->
                        <div class="row g-3 mb-4">
                            <!-- In Safe -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-primary border-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-muted fw-bold small text-uppercase">شيكات بالخزينة (متاحة للتداول)</div>
                                                <div class="fs-2 fw-bolder text-primary mt-1">
                                                    <field name="count_in_safe"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_in_safe"/>
                                                </div>
                                            </div>
                                            <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                                                <i class="fa fa-archive fa-2x" title="In Safe"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_in_safe" string="عرض الشيكات بالخزينة →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Under Collection -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-warning border-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-muted fw-bold small text-uppercase">برسم التحصيل في البنك</div>
                                                <div class="fs-2 fw-bolder text-warning mt-1">
                                                    <field name="count_deposited"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_deposited"/>
                                                </div>
                                            </div>
                                            <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                                                <i class="fa fa-university fa-2x" title="Bank Collection"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_deposited" string="عرض شيكات برسم التحصيل →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-warning"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Endorsed -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-info border-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-muted fw-bold small text-uppercase">شيكات مظهرة (مسلمة للغير)</div>
                                                <div class="fs-2 fw-bolder text-info mt-1">
                                                    <field name="count_endorsed"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_endorsed"/>
                                                </div>
                                            </div>
                                            <div class="bg-info-subtle text-info p-3 rounded-circle">
                                                <i class="fa fa-share-alt fa-2x" title="Endorsed"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_endorsed" string="عرض الشيكات المظهرة →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-info"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: Secondary States (Cleared, Bounced, Overdue) -->
                        <div class="row g-3 mb-4">
                            <!-- Cleared -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-success border-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-muted fw-bold small text-uppercase">تم التحصيل / الصرف بنجاح</div>
                                                <div class="fs-2 fw-bolder text-success mt-1">
                                                    <field name="count_cleared"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_cleared"/>
                                                </div>
                                            </div>
                                            <div class="bg-success-subtle text-success p-3 rounded-circle">
                                                <i class="fa fa-check-circle fa-2x" title="Cleared"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_cleared" string="عرض الشيكات المحصلة →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-success"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bounced -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-danger border-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-muted fw-bold small text-uppercase">شيكات مرتدة / مرفوضة</div>
                                                <div class="fs-2 fw-bolder text-danger mt-1">
                                                    <field name="count_bounced"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_bounced"/>
                                                </div>
                                            </div>
                                            <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                                                <i class="fa fa-times-circle fa-2x" title="Bounced"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_bounced" string="عرض الشيكات المرتدة →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-danger"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Overdue / Alerts -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 shadow-sm border-0 border-start border-dark border-4 bg-light">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="text-danger fw-bold small text-uppercase">متأخرة عن موعد الاستحقاق</div>
                                                <div class="fs-2 fw-bolder text-danger mt-1">
                                                    <field name="count_overdue"/> <span class="fs-6 text-muted font-monospace">شيك</span>
                                                </div>
                                                <div class="fw-semibold text-dark mt-1">
                                                    <field name="amount_overdue"/>
                                                </div>
                                            </div>
                                            <div class="bg-danger text-white p-3 rounded-circle">
                                                <i class="fa fa-bell fa-2x" title="Alerts"/>
                                            </div>
                                        </div>
                                        <div class="mt-3 pt-2 border-top">
                                            <button name="action_view_overdue" string="متابعة الشيكات المتأخرة →" type="object" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold text-danger"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 3: Upcoming Due Date & Total Portfolio Overview -->
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="card shadow-sm border-0 p-3 h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted fw-bold">شيكات تستحق خلال الـ 7 أيام القادمة</span>
                                            <h4 class="fw-bold mt-1 text-primary">
                                                <field name="count_due_this_week"/> شيك بقيمة <field name="amount_due_this_week"/>
                                            </h4>
                                        </div>
                                        <button name="action_view_due_this_week" string="عرض القائمة" type="object" class="btn btn-outline-primary btn-sm"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="card shadow-sm border-0 p-3 h-100 bg-body-tertiary">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted fw-bold">إجمالي محفظة الشيكات الكلية</span>
                                            <h4 class="fw-bold mt-1 text-dark">
                                                <field name="count_total"/> شيك بقيمة إجمالية <field name="amount_total"/>
                                            </h4>
                                        </div>
                                        <button name="action_view_all" string="كشف المحفظة" type="object" class="btn btn-dark btn-sm"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Dashboard Action -->
        <record id="action_check_dashboard" model="ir.actions.server">
            <field name="name">Cheques Dashboard / لوحة مؤشرات الشيكات</field>
            <field name="model_id" ref="model_check_dashboard"/>
            <field name="state">code</field>
            <field name="code">
action = model.action_open_dashboard()
            </field>
        </record>

    </data>
</odoo>
