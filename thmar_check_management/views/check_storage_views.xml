<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_check_storage_drawer_form" model="ir.ui.view">
            <field name="name">check.storage.drawer.form</field>
            <field name="model">check.storage.drawer</field>
            <field name="arch" type="xml">
                <form string="Check Storage Drawer / خزينة أو درج حفظ الشيكات">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Safe / Drawer Name (اسم الخزينة أو الدرج)"/>
                            <h1>
                                <field name="name" placeholder="e.g. خزينة المصنع الرئيسية - درج الشيكات الواردة"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="e.g. SAFE-01"/>
                                <field name="responsible_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="checks_count" string="عدد الشيكات الموجودة حالياً"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Current Checks in Safe / الشيكات الموجودة بالخزينة" name="checks_page">
                                <field name="check_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="bank_id"/>
                                        <field name="due_date"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="storage_division" string="الخانة/الرف"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description / الوصف" name="desc_page">
                                <field name="description" placeholder="موقع الخزينة، المفاتيح، أو أي تعليمات أمنية..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_check_storage_drawer_list" model="ir.ui.view">
            <field name="name">check.storage.drawer.list</field>
            <field name="model">check.storage.drawer</field>
            <field name="arch" type="xml">
                <list string="Safes &amp; Drawers">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="responsible_id"/>
                    <field name="checks_count"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="action_check_storage_drawer" model="ir.actions.act_window">
            <field name="name">Check Safes &amp; Drawers / خزائن وأدراج الشيكات</field>
            <field name="res_model">check.storage.drawer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    قم بتعريف الخزائن والأدراج الفيزيائية لحفظ الشيكات الورقية وتتبع موقع كل شيك.
                </p>
            </field>
        </record>

    </data>
</odoo>
