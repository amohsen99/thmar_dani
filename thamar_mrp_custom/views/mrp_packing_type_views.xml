<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_packing_type_view_tree" model="ir.ui.view">
        <field name="name">mrp.packing.type.tree</field>
        <field name="model">mrp.packing.type</field>
        <field name="arch" type="xml">
            <list string="Packing Types" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_packing_type_view_form" model="ir.ui.view">
        <field name="name">mrp.packing.type.form</field>
        <field name="model">mrp.packing.type</field>
        <field name="arch" type="xml">
            <form string="Packing Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_packing_type_action" model="ir.actions.act_window">
        <field name="name">Packing Types</field>
        <field name="res_model">mrp.packing.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new packing type
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_packing_type_menu"
              name="Packing Types"
              parent="mrp.menu_mrp_configuration"
              action="mrp_packing_type_action"
              sequence="202"/>
</odoo>
