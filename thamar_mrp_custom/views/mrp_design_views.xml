<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_design_view_tree" model="ir.ui.view">
        <field name="name">mrp.design.tree</field>
        <field name="model">mrp.design</field>
        <field name="arch" type="xml">
            <list string="Designs">
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_design_view_form" model="ir.ui.view">
        <field name="name">mrp.design.form</field>
        <field name="model">mrp.design</field>
        <field name="arch" type="xml">
            <form string="Design">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image', 'size': [200, 200]}"/>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_design_action" model="ir.actions.act_window">
        <field name="name">Designs</field>
        <field name="res_model">mrp.design</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new design
            </p>
            <p>
                Define designs for manufacturing orders with images.
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_design_menu"
              name="Designs"
              parent="mrp.menu_mrp_configuration"
              action="mrp_design_action"
              sequence="201"/>
</odoo>

