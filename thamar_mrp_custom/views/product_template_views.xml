<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View - Add Features Tab -->
    <record id="product_template_form_view_inherit_thamar" model="ir.ui.view">
        <field name="name">product.template.form.inherit.thamar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Add Features tab before the closing notebook tag -->
            <xpath expr="//notebook" position="inside">
                <page string="Product Specifications" name="features">
                    <group>
                        <group string="Basic Specifications">
                            <field name="fabric_type_id"/>
                            <field name="operation"/>
                            <field name="finishing_type"/>
                            <field name="custom_finishing" invisible="finishing_type != 'custom'" required="finishing_type == 'custom'"/>
                            <field name="custom_finishing_image" widget="image" invisible="finishing_type != 'custom'"/>
                            <field name="packing_type"/>    
                            <field name="stripe_id"/>
                            <field name="color_id" invisible="operation == 'dyeing'"/>
                            <field name="design_id" invisible="operation == 'dyeing'"/>
                        </group>
                        <group string="Calculations">
                            <field name="width"/>
                            <field name="product_weight"/>
                            <field name="average" readonly="1"/>
                        </group>
                    </group>

                    <!-- Display design image when design is selected -->
                    <group string="Design Preview" invisible="not design_id or operation == 'dyeing'">
                        <field name="design_image" widget="image" options="{'size': [400, 400]}" nolabel="1" readonly="1"/>
                    </group>

                    <!-- Info message -->
                    <div class="alert alert-info" role="alert">
                        <strong>ℹ Info:</strong> These specifications will be automatically copied to:
                        <ul>
                            <li>Sale Orders when this product is selected</li>
                            <li>Manufacturing Orders when this product is selected</li>
                        </ul>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Product Template Tree View - Add operation column -->
    <record id="product_template_tree_view_inherit_thamar" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.thamar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="operation" optional="show"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">operation == 'printing'</attribute>
                <attribute name="decoration-warning">operation == 'dyeing'</attribute>
                <attribute name="decoration-success">operation == 'printing_dyeing'</attribute>
            </xpath>
        </field>
    </record>

</odoo>

