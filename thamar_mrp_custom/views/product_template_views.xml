<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View - Add Features Tab -->
    <record id="product_template_form_view_inherit_thamar" model="ir.ui.view">
        <field name="name">product.template.form.inherit.thamar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Add Features tab before the closing notebook tag -->
            <xpath expr="//notebook" position="inside">
                <page string="Features" name="features">
                    <!-- Checkbox to enable features -->
                    <group>
                        <group>
                            <field name="has_features" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <separator string="Product Specifications" invisible="not has_features"/>
                    
                    <group invisible="not has_features">
                        <group string="Product Specifications">
                            <field name="operation" required="has_features"/>
                            <field name="finishing_type" required="has_features"/>
                            <field name="packing_type" required="has_features"/>
                            <field name="stripe" required="has_features"/>
                            <field name="color_id" required="has_features"/>
                            <field name="design_id" required="has_features"/>
                        </group>
                        <group string="Calculations">
                            <field name="width" required="has_features"/>
                            <field name="product_weight" required="has_features"/>
                            <!-- <field name="density"/> -->
                            <field name="average" readonly="1"/>
                        </group>
                    </group>

                    <!-- Display design image when design is selected -->
                    <group string="Design Preview" invisible="not design_id or not has_features">
                        <field name="design_image" widget="image" options="{'size': [400, 400]}" nolabel="1" readonly="1"/>
                    </group>

                    <!-- Info message -->
                    <div class="alert alert-info" role="alert" invisible="not has_features">
                        <strong>ℹ Info:</strong> These specifications will be automatically copied to:
                        <ul>
                            <li>Sale Orders when this product is selected</li>
                            <li>Manufacturing Orders when this product is selected</li>
                        </ul>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Product Template Tree View - Add has_features column -->
    <record id="product_template_tree_view_inherit_thamar" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.thamar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="has_features" optional="hide" widget="boolean_toggle"/>
                <field name="operation" optional="show"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">operation == 'printing'</attribute>
                <attribute name="decoration-warning">operation == 'dyeing'</attribute>
                <attribute name="decoration-success">operation == 'printing_dyeing'</attribute>
            </xpath>
        </field>
    </record>

</odoo>

