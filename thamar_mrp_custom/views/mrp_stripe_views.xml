<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_stripe_view_tree" model="ir.ui.view">
        <field name="name">mrp.stripe.tree</field>
        <field name="model">mrp.stripe</field>
        <field name="arch" type="xml">
            <list string="Stripes" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_stripe_view_form" model="ir.ui.view">
        <field name="name">mrp.stripe.form</field>
        <field name="model">mrp.stripe</field>
        <field name="arch" type="xml">
            <form string="Stripe">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_stripe_action" model="ir.actions.act_window">
        <field name="name">Stripes</field>
        <field name="res_model">mrp.stripe</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new stripe
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_stripe_menu"
              name="Stripes"
              parent="mrp.menu_mrp_configuration"
              action="mrp_stripe_action"
              sequence="202"/>
</odoo>
