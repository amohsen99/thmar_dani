<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_fabric_type_view_tree" model="ir.ui.view">
        <field name="name">mrp.fabric.type.tree</field>
        <field name="model">mrp.fabric.type</field>
        <field name="arch" type="xml">
            <list string="Fabric Types" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_fabric_type_view_form" model="ir.ui.view">
        <field name="name">mrp.fabric.type.form</field>
        <field name="model">mrp.fabric.type</field>
        <field name="arch" type="xml">
            <form string="Fabric Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_fabric_type_action" model="ir.actions.act_window">
        <field name="name">Fabric Types</field>
        <field name="res_model">mrp.fabric.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new fabric type
            </p>
            <p>
                Define fabric constructions and materials (e.g., Single Lycra, Interlock).
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_fabric_type_menu"
              name="Fabric Types"
              parent="mrp.menu_mrp_configuration"
              action="mrp_fabric_type_action"
              sequence="210"/>
</odoo>
