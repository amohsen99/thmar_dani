<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_color_view_tree" model="ir.ui.view">
        <field name="name">mrp.color.tree</field>
        <field name="model">mrp.color</field>
        <field name="arch" type="xml">
            <list string="Colors">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="customer"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_color_view_form" model="ir.ui.view">
        <field name="name">mrp.color.form</field>
        <field name="model">mrp.color</field>
        <field name="arch" type="xml">
            <form string="Color">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="customer"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes about this color..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_color_action" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">mrp.color</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new color
            </p>
            <p>
                Define colors for manufacturing orders with codes and customer associations.
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_color_menu"
              name="Colors"
              parent="mrp.menu_mrp_configuration"
              action="mrp_color_action"
              sequence="200"/>
</odoo>

