<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="mrp_color_category_view_tree" model="ir.ui.view">
        <field name="name">mrp.color.category.tree</field>
        <field name="model">mrp.color.category</field>
        <field name="arch" type="xml">
            <list string="Color Categories">
                <field name="name"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="mrp_color_category_view_form" model="ir.ui.view">
        <field name="name">mrp.color.category.form</field>
        <field name="model">mrp.color.category</field>
        <field name="arch" type="xml">
            <form string="Color Category">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes about this category..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mrp_color_category_action" model="ir.actions.act_window">
        <field name="name">Color Categories</field>
        <field name="res_model">mrp.color.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new color category
            </p>
            <p>
                Define categories to organize your colors.
            </p>
        </field>
    </record>

    <!-- Menu Item under Manufacturing > Configuration -->
    <menuitem id="mrp_color_category_menu"
              name="Color Categories"
              parent="mrp.menu_mrp_configuration"
              action="mrp_color_category_action"
              sequence="199"/>
</odoo>

