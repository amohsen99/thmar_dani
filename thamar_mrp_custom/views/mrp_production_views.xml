<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_thamar" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.thamar</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add partner and sale order fields in the right group after user_id -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="partner_id" readonly="state in ['cancel', 'done']"/>
                <field name="sale_order_id" readonly="state in ['cancel', 'done']"/>
            </xpath>
        </field>
    </record>
</odoo>

