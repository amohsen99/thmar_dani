<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_thamar" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.thamar</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">


            <!-- Add Features tab before the closing notebook tag -->
            <xpath expr="//notebook" position="inside">
                <page string="Product Specifications" name="features">
                    <group>
                        <group string="Product Specifications">
                            <field name="fabric_type_id"/>
                            <field name="finishing_type"/>
                            <field name="custom_finishing" invisible="finishing_type != 'custom'"/>
                            <field name="custom_finishing_image" widget="image" invisible="finishing_type != 'custom'"/>
                            <field name="operation"/>
                            <field name="packing_type"/>
                            <field name="stripe_id"/>
                            <field name="color_id" invisible="operation == 'dyeing'"/>
                            <field name="design_id" invisible="operation == 'dyeing'"/>
                        </group>
                        <group string="Calculations">
                            <field name="width"/>
                            <field name="product_weight"/>
                            <field name="average" readonly="1"/>
                        </group>
                    </group>

                    <!-- Display design image when design is selected -->
                    <group string="Design Preview" invisible="not design_id or operation == 'dyeing'">
                        <field name="design_image" widget="image" options="{'size': [400, 400]}" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_list_view_inherit_thamar" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit.thamar</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list | //tree" position="attributes">
                <attribute name="decoration-info">operation == 'printing'</attribute>
                <attribute name="decoration-warning">operation == 'dyeing'</attribute>
                <attribute name="decoration-success">operation == 'printing_dyeing'</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="finishing_type" optional="hide" />
                <field name="operation" optional="show" />
                <field name="packing_type" optional="hide" />
                <field name="stripe_id" optional="hide" />
                <field name="color_id" optional="hide" />
                <field name="design_id" optional="hide" />
                <field name="width" optional="hide" />
                <field name="product_weight" optional="hide" />
                <field name="average" optional="hide" />
            </xpath>
        </field>
    </record>
    <record id="mrp_production_action_thamar" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders (Thamar)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new manufacturing order
          </p>
        </field>
    </record>

    <menuitem id="menu_mrp_production_thamar"
              name="Manufacturing Orders (Thamar)"
              parent="mrp.menu_mrp_manufacturing"
              action="mrp_production_action_thamar"
              sequence="1"/>
</odoo>

