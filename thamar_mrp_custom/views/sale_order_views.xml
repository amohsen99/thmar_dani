<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View - Add Features Tab -->
    <record id="sale_order_form_view_inherit_thamar" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.thamar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Manufacturing Orders smart button -->
            <!-- <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mrp_production"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        invisible="mrp_production_count == 0">
                    <field name="mrp_production_count" widget="statinfo" string="Manufacturing"/>
                </button>
            </xpath> -->

            <!-- Add features to order lines tree -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="product_has_features" optional="hide" widget="boolean_toggle"/>
                <field name="finishing_type" optional="hide"/>
                <field name="packing_type" optional="hide"/>
                <field name="stripe" optional="hide"/>
                <field name="color_id" optional="hide"/>
                <field name="design_id" optional="hide"/>
            </xpath>

            <!-- Add features to order line form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="product_has_features" invisible="1"/>

                <!-- Features Section - Only visible if product has features -->
                <group string="Product Features" invisible="not product_has_features" colspan="4">
                    <group>
                        <field name="finishing_type" required="product_has_features"/>
                        <field name="packing_type" required="product_has_features"/>
                        <field name="stripe" required="product_has_features"/>
                        <field name="color_id" required="product_has_features"/>
                        <field name="design_id" required="product_has_features"/>
                    </group>
                    <group>
                        <field name="width" required="product_has_features"/>
                        <field name="weight" required="product_has_features"/>
                        <field name="density" required="product_has_features"/>
                        <field name="average" readonly="1"/>
                    </group>
                </group>

                <!-- Design Preview -->
                <group invisible="not design_id or not product_has_features" colspan="4">
                    <field name="design_image" widget="image" options="{'size': [300, 300]}" nolabel="1" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Sale Order Tree View - Add MRP count -->
    <record id="sale_order_tree_view_inherit_thamar" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.thamar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="has_featured_products" optional="hide" widget="boolean_toggle"/>
                <field name="mrp_production_count" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>

