<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════
         SHIPPING COMPANY – Views
         ════════════════════════════════════════════════════════ -->
    <record id="logistics_shipping_company_list" model="ir.ui.view">
        <field name="name">logistics.shipping.company.list</field>
        <field name="model">logistics.shipping.company</field>
        <field name="arch" type="xml">
            <list string="Shipping Companies" editable="bottom">
                <field name="name"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="logistics_shipping_company_form" model="ir.ui.view">
        <field name="name">logistics.shipping.company.form</field>
        <field name="model">logistics.shipping.company</field>
        <field name="arch" type="xml">
            <form string="Shipping Company">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="logistics_shipping_company_action" model="ir.actions.act_window">
        <field name="name">Shipping Companies</field>
        <field name="res_model">logistics.shipping.company</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a shipping company
            </p>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════
         PORT – Views
         ════════════════════════════════════════════════════════ -->
    <record id="logistics_port_list" model="ir.ui.view">
        <field name="name">logistics.port.list</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <list string="Ports" editable="bottom">
                <field name="name"/>
                <field name="country_id"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="logistics_port_form" model="ir.ui.view">
        <field name="name">logistics.port.form</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <form string="Port">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="logistics_port_action" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">logistics.port</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a port
            </p>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════
         BANKS – Action (uses built-in res.bank)
         ════════════════════════════════════════════════════════ -->
    <record id="logistics_bank_action" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">res.bank</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a bank
            </p>
        </field>
    </record>

</odoo>
