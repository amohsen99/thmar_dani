<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Sequence -->
    <record id="seq_logistics_contract" model="ir.sequence">
        <field name="name">Logistics Contract</field>
        <field name="code">logistics.contract</field>
        <field name="prefix">LOG/CON/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Shipment Sequence -->
    <record id="seq_logistics_shipment" model="ir.sequence">
        <field name="name">Logistics Shipment</field>
        <field name="code">logistics.shipment</field>
        <field name="prefix">LOG/SHP/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
