<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cartella_card_print_page" name="Cartella Card - Print View">
        <html lang="en" dir="ltr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Print Label - <t t-esc="card.sequence_number"/></title>
                <style>
                    @page {
                        margin: 0mm !important;
                        size: 100mm 70mm !important;
                    }
                    *, *::before, *::after {
                        box-sizing: border-box;
                        margin: 0;
                        padding: 0;
                    }
                    html, body {
                        width: 100%;
                        height: 100%;
                        margin: 0;
                        padding: 0;
                        background: #fff !important;
                    }
                    body {
                        font-family: Arial, sans-serif;
                    }
                    .no-print {
                        text-align: center;
                        padding: 8px;
                        background: #f0f2f5;
                        width: 100%;
                    }
                    .print-btn {
                        padding: 10px 24px;
                        background: #212529;
                        color: #fff;
                        border: none;
                        border-radius: 6px;
                        font-size: 14px;
                        cursor: pointer;
                    }
                    .label-page {
                        width: 100mm;
                        height: 70mm;
                        box-sizing: border-box;
                        padding: 0;
                        margin: 0;
                        border: 2px solid #000;
                        display: flex;
                        flex-direction: row;
                        font-size: 11pt;
                        color: #000;
                        background: #fff;
                        overflow: hidden;
                    }
                    .label-left {
                        flex: 1;
                        display: flex;
                        flex-direction: column;
                        min-width: 0;
                        padding: 0;
                    }
                    .label-right {
                        width: 28mm;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 2mm;
                        border-left: 1.5px solid #000;
                        padding: 2mm 2mm;
                        flex-shrink: 0;
                    }
                    .label-table {
                        width: 100%;
                        height: 100%;
                        border-collapse: collapse;
                        font-size: 10pt;
                        font-weight: bold;
                        border: none;
                    }
                    .label-table td {
                        padding: 1.2mm 2mm;
                        border: 0.5px solid #ccc;
                        word-wrap: break-word;
                        overflow: hidden;
                        vertical-align: middle;
                    }
                    .label-table .lbl {
                        width: 38%;
                        background: #e8eeff;
                        font-size: 12pt;
                        white-space: nowrap;
                        border-right: 1px solid #aaa;
                    }
                    .label-table .val {
                        text-align: center;
                        font-size: 12pt;
                    }
                    .label-table tr {
                        height: 20%;
                    }
                    .label-table tr:nth-child(even) .lbl,
                    .label-table tr:nth-child(even) .val {
                        background: #ffffff;
                    }
                    .qr-img {
                        width: 26mm;
                        height: 26mm;
                        display: block;
                        object-fit: contain;
                    }
                    .qr-label {
                        font-size: 10pt;
                        color: #555;
                        text-align: center;
                        letter-spacing: 0.3px;
                    }
                    .label-barcode {
                        font-family: 'Courier New', monospace;
                        font-size: 6.5pt;
                        font-weight: bold;
                        letter-spacing: 0.4px;
                        background: #f0f0f0;
                        border: 1px solid #ccc;
                        border-radius: 1px;
                        padding: 0.5mm 1mm;
                        display: inline-block;
                        text-align: center;
                        max-width: 100%;
                        word-break: break-all;
                    }
                    @media print {
                        .no-print {
                            display: none !important;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="no-print">
                    <button class="print-btn" onclick="window.print()">
                        🖨 Print Label
                    </button>
                </div>

                <div class="label-page">
                    <!-- Left: Info Table -->
                    <div class="label-left">
                        <table class="label-table">
                            <tr>
                                <td class="lbl">Product</td>
                                <td class="val">
                                    <t t-esc="card.finished_product_id.name or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Code</td>
                                <td class="val">
                                    <t t-esc="card.reference or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Width</td>
                                <td class="val">
                                    <t t-esc="card.finished_width_display or ''"/> cm
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Weight</td>
                                <td class="val">
                                    <t t-esc="card.finished_weight_display or ''"/> g/m²
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Composition</td>
                                <td class="val">
                                    <t t-if="card.blend_ratio_id">
                                        <t t-esc="card.blend_ratio_id or ''"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="card.barcode or ''"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Right: QR Code + barcode -->
                    <div class="label-right">
                        <t t-if="card.qr_image">
                            <img t-att-src="image_data_uri(card.qr_image)" alt="QR Code" class="qr-img"/>
                            <span class="qr-label">Scan QR</span>
                        </t>
                        <t t-if="card.barcode">
                            <div class="label-barcode">
                                <t t-esc="card.barcode"/>
                            </div>
                        </t>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
