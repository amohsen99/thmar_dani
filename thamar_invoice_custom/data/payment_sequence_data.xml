<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Inbound (Receive) Payments -->
        <record id="seq_payment_inbound" model="ir.sequence">
            <field name="name">Payment Inbound Sequence</field>
            <field name="code">account.payment.inbound</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Outbound (Send) Payments -->
        <record id="seq_payment_outbound" model="ir.sequence">
            <field name="name">Payment Outbound Sequence</field>
            <field name="code">account.payment.outbound</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
