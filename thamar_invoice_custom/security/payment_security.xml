<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Payment Confirmation Group -->
        <record id="group_payment_confirm" model="res.groups">
            <field name="name">Payment Confirmer</field>
            <!-- <field name="category_id" ref="base.module_category_accounting"/> -->
            <field name="comment">Users in this group can confirm payments (action_post)</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Payment Validation Group -->
        <record id="group_payment_validate" model="res.groups">
            <field name="name">Payment Validator</field>
            <!-- <field name="category_id" ref="base.module_category_accounting"/> -->
            <field name="comment">Users in this group can validate payments (action_validate)</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
    </data>
</odoo>

