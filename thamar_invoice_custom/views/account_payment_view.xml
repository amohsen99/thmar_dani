<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_groups" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.groups</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Add groups attribute to Confirm button -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="groups">thamar_invoice_custom.group_payment_confirm</attribute>
            </xpath>

            <!-- Add groups attribute to Validate button -->
            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="groups">thamar_invoice_custom.group_payment_validate</attribute>
            </xpath>
        </field>
    </record>
</odoo>

