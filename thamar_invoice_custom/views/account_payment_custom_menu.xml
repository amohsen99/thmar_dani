<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Editable list View for Payments -->
    <record id="view_account_payment_list_editable_custom" model="ir.ui.view">
        <field name="name">account.payment.list.editable.custom</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Payments" editable="bottom" create="true" delete="true">
                <field name="date"/>
                <field name="name" readonly="1"/>
                <field name="partner_id" required="1"/>
                <field name="journal_id" required="1" domain="[('type', 'in', ('bank', 'cash'))]"/>
                <field name="payment_method_line_id" required="1"/>
                <field name="amount" required="1"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="bank_id" optional="show"/>
                <field name="cheque_number" optional="show"/>
                <field name="cheque_due_date" optional="show"/>
                <field name="is_approved" widget="boolean_toggle" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'posted'"/>
                <button name="action_post" string="Confirm" type="object" icon="fa-check" 
                        invisible="state != 'draft' or (payment_type == 'outbound' and not is_approved)"/>
                <button name="action_approve_payment" string="Approve" type="object" icon="fa-thumbs-up"
                        invisible="state != 'draft' or is_approved or payment_type != 'outbound'"
                        groups="thamar_invoice_custom.group_payment_approval"/>
            </list>
        </field>
    </record>

    <!-- Action for Customer Receipts (Send) -->
    <record id="action_account_payments_receive_custom" model="ir.actions.act_window">
        <field name="name">Receive Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_payment_list_editable_custom"/>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'search_default_inbound_filter': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              Register a new payment
            </p>
        </field>
    </record>

    <!-- Action for Vendor Payments (Send) -->
    <record id="action_account_payments_send_custom" model="ir.actions.act_window">
        <field name="name">Send Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_payment_list_editable_custom"/>
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'search_default_outbound_filter': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              Register a new payment
            </p>
        </field>
    </record>

    <!-- Top Level Menu -->
    <menuitem id="menu_custom_payments_root"
              name="Payments Custom"
              web_icon="account,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_action_account_payments_receive_custom"
              name="Receive Payments"
              parent="menu_custom_payments_root"
              action="action_account_payments_receive_custom"
              sequence="10"/>

    <menuitem id="menu_action_account_payments_send_custom"
              name="Send Payments"
              parent="menu_custom_payments_root"
              action="action_account_payments_send_custom"
              sequence="20"/>

</odoo>
