<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Payment Receipt Template Document -->
    <template id="custom_report_payment_receipt_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="values" t-value="o._get_payment_receipt_report_values()"/>
            <t t-set="is_arabic" t-value="lang and 'ar' in lang"/>

            <div t-attf-class="page {{ 'arabic-layout' if is_arabic else '' }}" t-attf-dir="{{ 'rtl' if is_arabic else 'ltr' }}">
                <style>
                    .arabic-layout {
                        font-family: 'DejaVu Sans', 'Arial', sans-serif;
                        text-align: right;
                    }
                    .arabic-layout .row {
                        direction: rtl;
                    }
                    .arabic-layout .col-6 {
                        text-align: right;
                    }
                    .arabic-layout .text-start {
                        text-align: right !important;
                    }
                    .arabic-layout .text-end {
                        text-align: left !important;
                    }
                    .signature-line {
                        border-bottom: 1px solid #000;
                        width: 80%;
                        padding-top: 30px;
                    }
                </style>

                <h3 style="margin-bottom: 20px; margin-top: 20px; padding-top: 20px;">
                    <strong>
                        <t t-if="is_arabic">
                            <t t-if="o.payment_type == 'inbound'">ايصال استلام</t>
                            <t t-if="o.payment_type == 'outbound'">ايصال دفع</t>
                            

                            <!-- <span t-field="o.payment_receipt_title"/> -->
:                            <span t-field="o.name"/>
                        </t>
                        <t t-else="">
                            <span t-field="o.payment_receipt_title"/>
:                            <span t-field="o.name"/>
                        </t>
                    </strong>
                </h3>

                <div class="mb-4 mt-3">
                    <!-- الصف الأول: عمودين -->
                    <div class="row">
                        <!-- العمود الأول: التاريخ، العميل، طريقة الدفع -->
                        <div class="col-6">
                            <!-- تاريخ الدفع / Payment Date -->
                            <div name="date" t-if="o.date" style="margin-bottom: 10px;">
                                <t t-if="is_arabic">
                                    تاريخ الدفع:                                    <span t-field="o.date"/>
                                </t>
                                <t t-else="">
                                    Payment Date: <span t-field="o.date"/>
                                </t>
                            </div>

                            <!-- العميل/المورد / Customer/Vendor -->
                            <div t-if="o.partner_type" style="margin-bottom: 10px;">
                                <t t-if="o.partner_type == 'customer'">
                                    <t t-if="is_arabic">عميل:</t>
                                    <t t-else="">Customer:</t>
                                </t>
                                <t t-else="">
                                    <t t-if="is_arabic">مورد:</t>
                                    <t t-else="">Vendor:</t>
                                </t>
                                <span t-field="o.partner_id"/>
                            </div>

                            <!-- طريقة الدفع / Payment Method -->
                             <div t-if="values['display_payment_method'] and o.payment_method_id" style="margin-bottom: 10px;">
                                <t t-if="is_arabic">
                                    طريقة الدفع: 
                                </t>
                                <t t-else="">
                                    Payment Method: 
                                </t>
                                <span t-field="o.payment_method_line_id.name"/>
                            </div>

                        </div>

                        <!-- العمود الثاني: معلومات الشيك -->
                        <div class="col-6">
                           
                            <t t-if="o.is_cheque_payment">
                                <div>
                                    <div t-if="o.bank_id" style="margin-bottom: 10px;">
                                        <t t-if="is_arabic">البنك:</t>
                                        <t t-else="">Bank:</t>
                                        <span t-field="o.bank_id.name"/>
                                        <br/>

                                    </div>
                                    <div t-if="o.cheque_number" style="margin-bottom: 10px;">
                                        <t t-if="is_arabic">رقم الشيك:</t>
                                        <t t-else="">Cheque Number:</t>
                                        <span t-field="o.cheque_number"/>
                                        <br/>

                                    </div>
                                    <div t-if="o.cheque_due_date" style="margin-bottom: 10px;">
                                        <t t-if="is_arabic">تاريخ الاستحقاق:</t>
                                        <t t-else="">Due Date:</t>
                                        <span t-field="o.cheque_due_date"/>

                                        <br/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="oe_structure " style="height: 10px;"></div>

                    <!-- المبلغ والمذكرة -->
                    <div class="row">
                        <div class="col-6" t-if="o.amount">
                            <t t-if="is_arabic">
                                مبلغ الدفع: 
                            </t>
                            <t t-else="">
                                Payment Amount: 
                            </t>
                            <t t-if="lang and 'ar' in lang">
                                <span t-esc="o.amount"/>
                                <span>جنيه</span>
                                <!-- <span>فقط لا غير</span> -->
                            </t>
                            <t t-else="">
                                <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </t>
                        </div>

                        <!-- المذكرة / Memo -->
                        <div class="col-6" t-if="o.memo">
                            <t t-if="is_arabic">
                                مذكرة: 
                            </t>
                            <t t-else="">
                                Memo: 
                            </t>
                            <span t-field="o.memo"/>
                        </div>
                    </div>

                    <!-- المبلغ كتابة / Amount in Words -->
                    <div class="row" t-if="o.amount" style="margin-top: 5px;">
                        <div class="col-12">
                            <strong>
                                <t t-if="is_arabic">المبلغ كتابة:</t>
                                <t t-else="">Amount in Words:</t>
                            </strong>
                            <span t-esc="o.amount_to_text_with_lang()"/>
                            <span>فقط لا غير</span>
                        </div>
                    </div>
                </div>

                <!-- قسم التوقيع / Signature Section -->
                <div class="oe_structure" style="height: 40px;"></div>

                <div class="row">
                    <div class="col-6">
                        <div class="signature-field">
                            <strong>
                                <t t-if="is_arabic">استلم بواسطة:</t>
                                <t t-else="">Received By:</t>
                            </strong>
                            <div class="signature-line mt-2"></div>
                            <div class="signature-label mt-1" style="font-size: 12px; color: #666;">
                                <t t-if="is_arabic">التوقيع والختم</t>
                                <t t-else="">Signature &amp; Stamp</t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="oe_structure"></div>
        </t>
    </template>

    <!-- Custom Payment Receipt Main Template -->
    <template id="custom_report_payment_receipt">
        <t t-call="web.html_container">
            <t t-set="is_arabic" t-value="docs.env.context.get('lang') and 'ar' in docs.env.context.get('lang')"/>
            
            <!-- If there is only one payment, or user selected exactly one payment -->
            <t t-if="len(docs) == 1">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.env.context.get('lang') or o.env.user.lang or o.partner_id.lang or o.company_id.partner_id.lang or 'en_US'"/>
                    <t t-call="thamar_invoice_custom.custom_report_payment_receipt_document" t-lang="lang"/>
                </t>
            </t>
            
            <!-- If multiple payments are selected, show them in a summary table -->
            <t t-else="">
                <t t-call="web.external_layout">
                    <div t-attf-class="page {{ 'arabic-layout' if is_arabic else '' }}" t-attf-dir="{{ 'rtl' if is_arabic else 'ltr' }}">
                        <style>
                            .arabic-layout {
                                font-family: 'DejaVu Sans', 'Arial', sans-serif;
                                text-align: right;
                            }
                            .arabic-layout .row {
                                direction: rtl;
                            }
                            .arabic-layout th, .arabic-layout td {
                                text-align: right;
                            }
                        </style>

                        <h3 style="margin-bottom: 20px; margin-top: 20px; padding-top: 20px;">
                            <strong>
                                <t t-if="is_arabic">ملخص مدفوعات</t>
                                <t t-else="">Payments Summary</t>
                            </strong>
                        </h3>

                        <table class="table table-sm table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th>
                                        <t t-if="is_arabic">الرقم</t>
                                        <t t-else="">Number</t>
                                    </th>
                                    <th>
                                        <t t-if="is_arabic">التاريخ</t>
                                        <t t-else="">Date</t>
                                    </th>
                                    <th>
                                        <t t-if="is_arabic">العميل/المورد</t>
                                        <t t-else="">Vendor/Customer</t>
                                    </th>
                                    <th>
                                        <t t-if="is_arabic">المبلغ</t>
                                        <t t-else="">Amount</t>
                                    </th>
                                    <th>
                                        <t t-if="is_arabic">رقم الشيك</t>
                                        <t t-else="">Cheque Number</t>
                                    </th>
                                    <th>
                                        <t t-if="is_arabic">مذكرة</t>
                                        <t t-else="">Memo</t>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_amount" t-value="0.0"/>
                                <t t-set="currency" t-value="docs[0].currency_id if docs else False"/>
                                <t t-foreach="docs" t-as="o">
                                    <t t-set="total_amount" t-value="total_amount + o.amount"/>
                                    <tr>
                                        <td><span t-field="o.name"/></td>
                                        <td><span t-field="o.date"/></td>
                                        <td><span t-field="o.partner_id.name"/></td>
                                        <td>
                                            <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td>
                                            <span t-if="o.cheque_number" t-field="o.cheque_number"/>
                                        </td>
                                        <td>
                                            <span t-if="o.memo" t-field="o.memo"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="3" class="text-end">
                                        <strong><t t-if="is_arabic">الإجمالي</t><t t-else="">Total</t></strong>
                                    </td>
                                    <td>
                                        <strong><span t-esc="total_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/></strong>
                                    </td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="oe_structure" style="height: 40px;"></div>

                <div class="row">
                    <div class="col-6">
                        <div class="signature-field">
                            <strong>
                                <t t-if="is_arabic">استلم بواسطة:</t>
                                <t t-else="">Received By:</t>
                            </strong>
                            <div class="signature-line mt-2"></div>
                            <div class="signature-label mt-1" style="font-size: 12px; color: #666;">
                                <t t-if="is_arabic">التوقيع والختم</t>
                                <t t-else="">Signature &amp; Stamp</t>
                            </div>
                        </div>
                    </div>
                </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>