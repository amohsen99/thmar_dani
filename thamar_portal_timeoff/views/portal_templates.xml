<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared employee portal shell: branding and primary navigation. -->
    <template id="portal_parent_branding" name="Portal: Al-Omar Parent Layout"
              inherit_id="portal.frontend_layout" priority="90">
        <xpath expr="//nav[hasclass('navbar')]" position="attributes">
            <attribute name="class" add="thamar-portal-navbar" separator=" "/>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]/div[hasclass('container')]" position="attributes">
            <attribute name="class" add="thamar-portal-navbar-inner" separator=" "/>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]//a[hasclass('navbar-brand')]" position="attributes">
            <attribute name="href">/my/home</attribute>
            <attribute name="class" add="thamar-portal-brand" separator=" "/>
            <attribute name="aria-label">الرئيسية لبوابة موظفي مجموعة العمر</attribute>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]//a[hasclass('navbar-brand')]/img" position="attributes">
            <attribute name="t-att-src"/>
            <attribute name="t-att-alt"/>
            <attribute name="t-att-title"/>
            <attribute name="src">/thamar_portal_timeoff/static/src/img/al_omar_group_logo.png</attribute>
            <attribute name="alt">Al-Omar Group</attribute>
            <attribute name="title">Al-Omar Group</attribute>
            <attribute name="class">thamar-portal-logo</attribute>
        </xpath>
        <xpath expr="//ul[@id='top_menu']/t[@t-call='portal.placeholder_user_sign_in']" position="before">
            <li t-if="not request.env.user._is_public()" class="nav-item thamar-portal-nav-item">
                <a href="/my/home" class="nav-link thamar-portal-nav-link">
                    <i class="fa fa-home" aria-hidden="true"/>
                    <span>الرئيسية</span>
                </a>
            </li>
            <li t-if="not request.env.user._is_public()" class="nav-item thamar-portal-nav-item">
                <a href="/my/employee" class="nav-link thamar-portal-nav-link">
                    <i class="fa fa-user" aria-hidden="true"/>
                    <span>ملفي الشخصي</span>
                </a>
            </li>
            <li t-if="not request.env.user._is_public()" class="nav-item thamar-portal-nav-item">
                <a href="/my/timeoff" class="nav-link thamar-portal-nav-link">
                    <i class="fa fa-calendar-check-o" aria-hidden="true"/>
                    <span>الإجازات</span>
                </a>
            </li>
            <!-- Temporary hidden hook: lets databases carrying the previous
                 overtime navigation view upgrade safely. A later inherited
                 cleanup view removes it from the final rendered layout. -->
            <li class="d-none thamar-legacy-assignments-hook" aria-hidden="true">
                <a href="/my/assignments" tabindex="-1"/>
            </li>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]" position="after">
            <nav t-if="not request.env.user._is_public()" class="thamar-mobile-nav"
                 aria-label="قائمة بوابة الموظف">
                <a href="/my/home" t-attf-class="#{'active' if page_name == 'home' else ''}">
                    <i class="fa fa-home" aria-hidden="true"/><span>الرئيسية</span>
                </a>
                <a href="/my/employee" t-attf-class="#{'active' if page_name == 'employee' else ''}">
                    <i class="fa fa-user" aria-hidden="true"/><span>ملفي</span>
                </a>
                <a href="/my/timeoff" t-attf-class="#{'active' if page_name == 'timeoff' else ''}">
                    <i class="fa fa-calendar-check-o" aria-hidden="true"/><span>الإجازات</span>
                </a>
                <a href="/my/assignments" class="d-none thamar-legacy-assignments-hook"
                   aria-hidden="true" tabindex="-1"/>
            </nav>
        </xpath>
    </template>

    <template id="portal_home_welcome" name="Portal: Employee Welcome"
              inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <section class="thamar-portal-welcome" aria-labelledby="thamar-welcome-title">
                <div>
                    <span class="thamar-portal-eyebrow">الخدمة الذاتية للموظف</span>
                    <h1 id="thamar-welcome-title">
                        مرحباً، <t t-out="user_id.name"/>
                    </h1>
                    <p>يمكنك الاطلاع على ملفك الوظيفي وإدارة طلبات الإجازات من مكان واحد وآمن.</p>
                </div>
                <a href="/my/timeoff" class="btn thamar-portal-primary-action">
                    <i class="fa fa-calendar-plus-o" aria-hidden="true"/>
                    طلب إجازة
                </a>
            </section>
        </xpath>
    </template>

    <!-- Portal Home: Time Off Counter Badge -->
    <template id="portal_my_home_timeoff" name="Portal: Time Off Entry"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/thamar_portal_timeoff/static/src/img/timeoff_icon.svg'"/>
                <t t-set="title">الإجازات</t>
                <t t-set="url" t-value="'/my/timeoff'"/>
                <t t-set="text">عرض ومتابعة جميع طلبات الإجازات والأنواع المرتبطة بها</t>
                <t t-set="placeholder_count" t-value="'timeoff_count'"/>
            </t>
        </div>
    </template>

    <!-- Portal Home: Employee Profile Entry -->
    <template id="portal_my_home_employee" name="Portal: Employee Profile Entry"
              inherit_id="thamar_portal_timeoff.portal_my_home_timeoff" priority="1">
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/thamar_portal_timeoff/static/src/img/employee_icon.svg'"/>
                <t t-set="title">ملفي الشخصي</t>
                <t t-set="url" t-value="'/my/employee'"/>
                <t t-set="text">عرض بياناتك الشخصية والوظيفية</t>
                <t t-set="placeholder_count" t-value="''"/>
            </t>
        </div>
    </template>

    <!-- Portal Home: Manager-created assignments -->
    <template id="portal_my_home_assignments" name="Portal: Assignments Entry (Disabled)"
              inherit_id="thamar_portal_timeoff.portal_my_home_timeoff" priority="2" active="False">
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/thamar_portal_timeoff/static/src/img/assignment_icon.svg'"/>
                <t t-set="title">التكليفات</t>
                <t t-set="url" t-value="'/my/assignments'"/>
                <t t-set="text">متابعة تكليفات العمل الإضافي المسجلة بواسطة المدير</t>
                <t t-set="placeholder_count" t-value="'assignment_count'"/>
            </t>
        </div>
    </template>

    <!-- Portal Home: Team leave management for department approvers -->
    <template id="portal_my_home_team_timeoff" name="Portal: Team Time Off Entry (Disabled)"
              inherit_id="thamar_portal_timeoff.portal_my_home_timeoff" priority="3" active="False">
        <div id="portal_client_category" position="inside">
            <t t-if="can_manage_team" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/thamar_portal_timeoff/static/src/img/team_timeoff_icon.svg'"/>
                <t t-set="title">إدارة إجازات وتكليفات الفريق</t>
                <t t-set="url" t-value="'/my/team/timeoff'"/>
                <t t-set="text">متابعة واعتماد طلبات موظفي الأقسام المسؤول عنها</t>
                <t t-set="placeholder_count" t-value="'team_leave_count'"/>
            </t>
        </div>
    </template>

    <!-- Portal Time Off Page -->
    <template id="portal_timeoff_page" name="Portal: Time Off Management">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">الإجازات</t>
            </t>

            <div class="d-flex justify-content-end flex-wrap gap-2 mb-4" dir="rtl">
                <a href="/my/timeoff"
                   t-attf-class="btn #{'btn-outline-primary' if timeoff_team else 'btn-primary'}">
                    إجازاتي
                </a>
                <a t-if="can_manage_team" href="/my/timeoff?scope=team"
                   t-attf-class="btn #{'btn-primary' if timeoff_team else 'btn-outline-primary'}">
                    إجازات الفريق
                </a>
            </div>

            <div t-if="timeoff_team" class="o_portal_team_timeoff_app">
                <div class="pto-loading text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جارٍ التحميل...</span>
                    </div>
                    <p class="mt-3 text-muted">جارٍ تحميل طلبات الفريق...</p>
                </div>
            </div>
            <div t-else="" class="o_portal_timeoff_app"
                 t-att-data-employee-id="employee_id" t-att-data-employee-name="employee_name">
                <div class="pto-loading text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جارٍ التحميل...</span>
                    </div>
                    <p class="mt-3 text-muted">جارٍ تحميل بيانات الإجازات...</p>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Assignments Page -->
    <template id="portal_assignments_page" name="Portal: Work Assignments (Disabled)" active="False">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">التكليفات</t>
            </t>

            <div class="o_portal_timeoff_app" data-request-kind="assignment"
                 t-att-data-employee-id="employee_id" t-att-data-employee-name="employee_name">
                <div class="pto-loading text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جارٍ التحميل...</span>
                    </div>
                    <p class="mt-3 text-muted">جارٍ تحميل بيانات التكليفات...</p>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Team Time Off Management Page -->
    <template id="portal_team_timeoff_page" name="Portal: Team Time Off Management (Disabled)" active="False">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">إدارة إجازات وتكليفات الفريق</t>
            </t>

            <div class="o_portal_team_timeoff_app" t-att-data-manager-name="employee_name">
                <div class="pto-loading text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جارٍ التحميل...</span>
                    </div>
                    <p class="mt-3 text-muted">جارٍ تحميل طلبات الفريق...</p>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Breadcrumb -->
    <template id="portal_breadcrumb_timeoff" name="Portal: Time Off Breadcrumb"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'timeoff'" class="breadcrumb-item active">
                الإجازات
            </li>
        </xpath>
    </template>

    <!-- Portal Employee Info Page -->
    <template id="portal_employee_page" name="Portal: Employee Information">
        <t t-call="portal.portal_layout">
            <t t-set="head">
                <t t-call-assets="thamar_portal_timeoff.assets_employee" defer_load="True"/>
            </t>
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">ملفي الشخصي</t>
            </t>

            <div class="o_portal_employee_app" t-att-data-employee-id="employee_id" t-att-data-employee-name="employee_name">
                <div class="text-center py-5" id="employee_loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جارٍ التحميل...</span>
                    </div>
                    <p class="mt-3 text-muted">جارٍ تحميل ملفك الشخصي...</p>
                </div>
            </div>
        </t>
    </template>

</odoo>
