<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dyeing_operation_list" model="ir.ui.view">
        <field name="name">thamar.dyeing.operation.list</field>
        <field name="model">thamar.dyeing.operation</field>
        <field name="arch" type="xml">
            <list string="متابعة المراحل" default_order="operation_date desc, work_order_id, sequence"
                  editable="bottom" open_form_view="True" multi_edit="1">
                <field name="sequence" optional="hide"/>
                <field name="name" optional="hide"/>
                <field name="work_order_id"/>
                <field name="stage_type_id"/>
                <field name="can_edit_customer" column_invisible="True"/>
                <field name="partner_id" readonly="not can_edit_customer"/>
                <field name="entry_time"/>
                <field name="exit_time"/>
                <field name="worker_name"/>
                <field name="dyeing_type_id"/>
                <field name="printing_type_id"/>
                <field name="machine_id" optional="show"/>
                <field name="batch_ids" widget="many2many_tags" optional="hide"/>
                <field name="weight_kg" optional="show"/>
                <field name="meter" optional="show"/>
                <field name="message_number" optional="show"/>
                <field name="operation_date" optional="show"/>
                <field name="shift" optional="show"/>
                <field name="shift_supervisor_id" optional="show"/>
                <field name="duration_hours" optional="show" sum="الإجمالي"/>
                <field name="total_cost" optional="show" sum="الإجمالي"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dyeing_operation_form" model="ir.ui.view">
        <field name="name">thamar.dyeing.operation.form</field>
        <field name="model">thamar.dyeing.operation</field>
        <field name="arch" type="xml">
            <form string="متابعة مرحلة">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_material_issues" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="material_issue_count" widget="statinfo"
                                   string="صرف المواد"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="work_order_id"/>
                            <field name="stage_type_id"/>
                            <field name="machine_id" options="{'no_create': True}"/>
                            <field name="next_stage_type_id"/>
                        </group>
                        <group>
                            <field name="operation_date"/>
                            <field name="shift"/>
                            <field name="shift_supervisor_id"/>
                            <field name="worker_name"/>
                            <field name="company_id" invisible="1"/>
                            <field name="can_edit_customer" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بيانات القماش" name="fabric">
                            <group>
                                <group>
                                    <field name="partner_id" readonly="not can_edit_customer"/>
                                    <field name="message_number"/>
                                    <field name="product_id"/>
                                    <field name="color_id"/>
                                </group>
                                <group>
                                    <field name="design_id"/>
                                    <field name="printing_type_id"/>
                                    <field name="dyeing_type_id"/>
                                    <field name="weight_kg"/>
                                    <field name="meter"/>
                                </group>
                            </group>
                        </page>
                        <page string="بيانات التشغيل" name="execution">
                            <group>
                                <group>
                                    <field name="entry_time"/>
                                    <field name="exit_time"/>
                                    <field name="duration_hours"/>
                                    <field name="batch_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                                <group>
                                    <field name="speed"/>
                                    <field name="temperature"/>
                                </group>
                            </group>
                        </page>
                        <page string="التكلفة" name="cost">
                            <group>
                                <field name="hourly_cost"/>
                                <field name="total_cost"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="المواد المصروفة" name="issued_materials">
                            <field name="material_move_ids" readonly="1">
                                <list string="المواد المصروفة"
                                      decoration-success="state == 'done'"
                                      decoration-muted="state == 'cancel'">
                                    <field name="picking_id" string="مستند الصرف"/>
                                    <field name="product_id" string="المادة"/>
                                    <field name="product_uom_qty" string="الكمية المطلوبة"/>
                                    <field name="quantity" string="الكمية المصروفة"/>
                                    <field name="product_uom" string="الوحدة"/>
                                    <field name="location_id" string="من مخزن" optional="show"/>
                                    <field name="location_dest_id" string="إلى" optional="hide"/>
                                    <field name="date" string="التاريخ" optional="show"/>
                                    <field name="state" string="حالة الصرف" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات المرحلة..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dyeing_operation_search" model="ir.ui.view">
        <field name="name">thamar.dyeing.operation.search</field>
        <field name="model">thamar.dyeing.operation</field>
        <field name="arch" type="xml">
            <search string="البحث في المراحل">
                <field name="name"/>
                <field name="work_order_id"/>
                <field name="message_number"/>
                <field name="partner_id"/>
                <field name="stage_type_id"/>
                <field name="machine_id"/>
                <field name="shift_supervisor_id"/>
                <filter name="group_stage" string="المرحلة" context="{'group_by': 'stage_type_id'}"/>
                <filter name="group_machine" string="الماكينة" context="{'group_by': 'machine_id'}"/>
                <filter name="group_work_order" string="الخطة" context="{'group_by': 'work_order_id'}"/>
                <filter name="group_shift" string="الوردية" context="{'group_by': 'shift'}"/>
                <filter name="group_date" string="التاريخ" context="{'group_by': 'operation_date'}"/>
            </search>
        </field>
    </record>

    <record id="view_dyeing_operation_pivot" model="ir.ui.view">
        <field name="name">thamar.dyeing.operation.pivot</field>
        <field name="model">thamar.dyeing.operation</field>
        <field name="arch" type="xml">
            <pivot string="تحليل المراحل">
                <field name="stage_type_id" type="row"/>
                <field name="machine_id" type="row"/>
                <field name="operation_date" type="col" interval="month"/>
                <field name="weight_kg" type="measure"/>
                <field name="meter" type="measure"/>
                <field name="duration_hours" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dyeing_operation" model="ir.actions.act_window">
        <field name="name">متابعة المراحل</field>
        <field name="res_model">thamar.dyeing.operation</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_dyeing_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد مراحل تشغيل حالية</p>
            <p>تُنشأ المراحل من الخطة، ويمكن لقسم التخطيط إضافة مرحلة من هنا.</p>
        </field>
    </record>

