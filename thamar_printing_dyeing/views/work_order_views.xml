<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dyeing_work_order_list" model="ir.ui.view">
        <field name="name">thamar.dyeing.work.order.list</field>
        <field name="model">thamar.dyeing.work.order</field>
        <field name="arch" type="xml">
            <list string="الخطط" default_order="date desc, id desc">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="message_number"/>
                <field name="product_id"/>
                <field name="color_id" optional="show"/>
                <field name="planned_weight_kg" optional="show"/>
                <field name="planned_meter" optional="show"/>
                <field name="actual_weight_kg" optional="show"/>
                <field name="actual_meter" optional="show"/>
                <field name="current_stage_id" optional="show"/>
                <field name="operation_count" optional="show"/>
                <field name="total_cost" sum="الإجمالي" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dyeing_work_order_form" model="ir.ui.view">
        <field name="name">thamar.dyeing.work.order.form</field>
        <field name="model">thamar.dyeing.work.order</field>
        <field name="arch" type="xml">
            <form string="الخطة">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_operations" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="operation_count" widget="statinfo" string="المراحل"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="بيانات التخطيط">
                            <field name="partner_id"/>
                            <field name="message_number"/>
                            <field name="date"/>
                            <field name="product_id" options="{'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="color_id"/>
                            <field name="design_id"/>
                            <field name="printing_type_id"/>
                            <field name="dyeing_type_id"/>
                            <field name="planned_weight_kg"/>
                            <field name="planned_meter"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="مسار المراحل" name="operations">
                            <field name="operation_ids" context="{'default_shift_supervisor_id': uid}">
                                <list editable="bottom" default_order="sequence, id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage_type_id"/>
                                    <field name="machine_id" optional="show"/>
                                    <field name="shift_supervisor_id" optional="show"/>
                                    <field name="shift" optional="show"/>
                                    <field name="operation_date" optional="show"/>
                                    <field name="weight_kg" optional="show"/>
                                    <field name="meter" optional="show"/>
                                    <field name="next_stage_type_id" optional="show"/>
                                    <field name="duration_hours" optional="show"/>
                                    <field name="total_cost" optional="show" sum="الإجمالي"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="الملخص" name="summary">
                            <group>
                                <group string="التنفيذ الفعلي">
                                    <field name="current_stage_id"/>
                                    <field name="actual_weight_kg" readonly="1"/>
                                    <field name="actual_meter" readonly="1"/>
                                    <field name="actual_quantities_set" readonly="1"/>
                                </group>
                                <group string="الوقت والتكلفة">
                                    <field name="actual_start_time"/>
                                    <field name="actual_end_time"/>
                                    <field name="total_cost"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات الخطة..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dyeing_work_order_search" model="ir.ui.view">
        <field name="name">thamar.dyeing.work.order.search</field>
        <field name="model">thamar.dyeing.work.order</field>
        <field name="arch" type="xml">
            <search string="البحث في الخطط">
                <field name="name"/>
                <field name="message_number"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="color_id"/>
                <filter name="group_partner" string="العميل" context="{'group_by': 'partner_id'}"/>
                <filter name="group_date" string="التاريخ" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_dyeing_work_order" model="ir.actions.act_window">
        <field name="name">الخطط</field>
        <field name="res_model">thamar.dyeing.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dyeing_work_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ أول خطة تشغيل</p>
            <p>أدخل الكميات المتوقعة وبيانات القماش ثم رتب مراحل التشغيل المطلوبة.</p>
        </field>
    </record>
</odoo>
