<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dyeing_machine_list" model="ir.ui.view">
        <field name="name">thamar.dyeing.machine.list</field>
        <field name="model">thamar.dyeing.machine</field>
        <field name="arch" type="xml">
            <list string="الماكينات" default_order="name, id">
                <field name="name"/>
                <field name="code"/>
                <field name="stage_type_ids" widget="many2many_tags"/>
                <field name="capacity_kg"/>
                <field name="water_cost_hour" optional="show"/>
                <field name="electricity_cost_hour" optional="show"/>
                <field name="gas_cost_hour" optional="show"/>
                <field name="other_cost_hour" optional="hide"/>
                <field name="hourly_cost" sum="الإجمالي"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dyeing_machine_form" model="ir.ui.view">
        <field name="name">thamar.dyeing.machine.form</field>
        <field name="model">thamar.dyeing.machine</field>
        <field name="arch" type="xml">
            <form string="ماكينة">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشفة" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="stage_type_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="capacity_kg"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="تكلفة الساعة">
                            <field name="water_cost_hour"/>
                            <field name="electricity_cost_hour"/>
                            <field name="gas_cost_hour"/>
                            <field name="other_cost_hour"/>
                            <field name="hourly_cost" class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ملاحظات"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dyeing_machine_search" model="ir.ui.view">
        <field name="name">thamar.dyeing.machine.search</field>
        <field name="model">thamar.dyeing.machine</field>
        <field name="arch" type="xml">
            <search string="البحث في الماكينات">
                <field name="name"/>
                <field name="code"/>
                <field name="stage_type_ids"/>
            </search>
        </field>
    </record>

    <record id="action_dyeing_machine" model="ir.actions.act_window">
        <field name="name">الماكينات</field>
        <field name="res_model">thamar.dyeing.machine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dyeing_machine_search"/>
    </record>
</odoo>
