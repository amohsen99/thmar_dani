<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_dyeing_material" model="ir.ui.view">
        <field name="name">stock.picking.form.dyeing.material</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='picking_type_id'])[1]" position="before">
                <field name="is_dyeing_material_issue" invisible="1"/>
            </xpath>
            <xpath expr="(//field[@name='picking_type_id'])[1]" position="after">
                <field name="dyeing_work_order_id"
                       string="الخطة"
                       invisible="not is_dyeing_material_issue"
                       required="is_dyeing_material_issue"
                       readonly="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
                <field name="dyeing_operation_id"
                       string="المرحلة"
                       invisible="not is_dyeing_material_issue"
                       required="is_dyeing_material_issue"
                       readonly="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_list_dyeing_material" model="ir.ui.view">
        <field name="name">stock.picking.list.dyeing.material</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_dyeing_material_issue" column_invisible="True"/>
                <field name="dyeing_work_order_id" optional="show"
                       invisible="not is_dyeing_material_issue"/>
                <field name="dyeing_operation_id" optional="show"
                       invisible="not is_dyeing_material_issue"/>
            </field>
        </field>
    </record>

    <record id="view_stock_picking_search_dyeing_material" model="ir.ui.view">
        <field name="name">stock.picking.search.dyeing.material</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="dyeing_work_order_id"/>
                <field name="dyeing_operation_id"/>
            </field>
        </field>
    </record>

    <record id="action_dyeing_material_issue" model="ir.actions.act_window">
        <field name="name">صرف مواد المراحل</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dyeing_material_issue', '=', True)]</field>
        <field name="context" eval="{
            'default_is_dyeing_material_issue': True,
            'restricted_picking_type_code': 'internal'
        }"/>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ مستند صرف مواد لمرحلة</p>
            <p>اختر الخطة والمرحلة، ثم أضف الكيماويات أو الأصباغ واعتمد حركة المخزون.</p>
        </field>
    </record>
</odoo>
