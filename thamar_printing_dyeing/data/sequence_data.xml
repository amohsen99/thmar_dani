<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dyeing_work_order" model="ir.sequence">
        <field name="name">خطة تشغيل طباعة وصباغة</field>
        <field name="code">thamar.dyeing.work.order</field>
        <field name="prefix">PLAN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dyeing_operation" model="ir.sequence">
        <field name="name">متابعة مرحلة طباعة وصباغة</field>
        <field name="code">thamar.dyeing.operation</field>
        <field name="prefix">OP/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dyeing_batch" model="ir.sequence">
        <field name="name">تشغيلة ماكينة مجمعة</field>
        <field name="code">thamar.dyeing.batch</field>
        <field name="prefix">BATCH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
