<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_transfer" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.transfer</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_internal_transfer_wizard" 
                        string="Add Component with Transfer" 
                        type="object" 
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_internal_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="internal_transfer_count == 0">
                    <field name="internal_transfer_count" widget="statinfo" string="Transfers"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
