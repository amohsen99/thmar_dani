<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form View - Add Fabric Weight Summary -->
    <record id="purchase_order_form_view_fabric" model="ir.ui.view">
        <field name="name">purchase.order.form.fabric.weight</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Fabric Summary before order lines -->
            <xpath expr="//field[@name='order_line']" position="before">
                <group invisible="not has_fabric" class="alert alert-info">
                    <group string="ملخص الأقمشة / Fabric Summary">
                        <field name="has_fabric" invisible="1"/>
                        <field name="fabric_total_weight" string="إجمالي الوزن (كجم)"/>
                        <field name="fabric_total_qty" string="إجمالي الأتواب"/>
                        <field name="fabric_total_meters" string="إجمالي الأمتار"/>
                    </group>
                </group>
            </xpath>

            <!-- Add weight columns to order lines -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="is_fabric" column_invisible="1"/>
                <field name="fabric_pieces" optional="show" string="عدد الأتواب"/>
                <field name="fabric_total_meters" optional="show" string="إجمالي الأمتار"/>
                <field name="fabric_avg_weight" optional="hide" string="متوسط وزن التوب"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Tree View - Add Fabric Columns -->
    <record id="purchase_order_tree_view_fabric" model="ir.ui.view">
        <field name="name">purchase.order.tree.fabric.weight</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="has_fabric" optional="hide"/>
                <field name="fabric_total_weight" optional="hide" string="إجمالي الوزن"/>
                <field name="fabric_total_qty" optional="hide" string="عدد الأتواب"/>
            </xpath>
        </field>
    </record>
</odoo>

