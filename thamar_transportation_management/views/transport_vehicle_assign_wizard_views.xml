<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_vehicle_assign_employee_wizard_form" model="ir.ui.view">
        <field name="name">transport.vehicle.assign.employee.wizard.form</field>
        <field name="model">transport.vehicle.assign.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="إضافة موظفين إلى المركبة">
                <group>
                    <field name="vehicle_id"/>
                    <field name="route_id"/>
                    <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_assign_employees" type="object" string="تسكين الموظفين" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
