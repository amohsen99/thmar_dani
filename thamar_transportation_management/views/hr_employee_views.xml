<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit_transport" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.transport</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']//field[@name='parent_id']" position="after">
                <separator string="Transportation"/>
                <field name="transport_route_id"/>
                <field name="transport_vehicle_id" domain="[('route_id', '=', transport_route_id), ('remaining_seats', '&gt;', 0)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_list_inherit_transport" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit.transport</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="transport_route_id" optional="show"/>
                <field name="transport_vehicle_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_transport_employee" model="ir.actions.act_window">
        <field name="name">الموظفون</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
    </record>
</odoo>
