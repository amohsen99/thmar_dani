<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Order Form: add authorization_number field -->
    <record id="view_purchase_order_form_inherit_auth_number" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.auth.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="authorization_number"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order List: add authorization_number column -->
    <record id="view_purchase_order_tree_inherit_auth_number" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.auth.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="authorization_number" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
