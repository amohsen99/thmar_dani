<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="overtime_list" model="ir.ui.view">
    <field name="name">thamar.overtime.request.list</field>
    <field name="model">thamar.overtime.request</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'approved'" decoration-danger="state == 'refused'">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="kind"/>
        <field name="date_start"/>
        <field name="date_stop"/>
        <field name="duration" widget="float_time"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>
  <record id="overtime_form" model="ir.ui.view">
    <field name="name">thamar.overtime.request.form</field>
    <field name="model">thamar.overtime.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" type="object" string="إرسال للمشرف" class="oe_highlight" invisible="state != 'draft' or not can_manage"/>
          <button name="action_approve" type="object" string="موافقة" class="oe_highlight" invisible="not can_approve"/>
          <button name="action_refuse" type="object" string="رفض" invisible="not can_approve"/>
          <button name="action_hr_approve" type="object" string="اعتماد الموارد البشرية" class="oe_highlight" invisible="not can_hr_approve"/>
          <button name="action_cancel" type="object" string="إلغاء" invisible="not can_manage or state in ['cancelled', 'refused']"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,supervisor,manager,hr,approved"/>
        </header>
        <sheet>
          <field name="can_manage" invisible="1"/>
          <field name="can_approve" invisible="1"/>
          <field name="can_hr_approve" invisible="1"/>
          <h1>
            <field name="name"/>
          </h1>
          <group>
            <group>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="department_id"/>
              <field name="kind" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </group>
            <group>
              <field name="date_start" readonly="state != 'draft'"/>
              <field name="date_stop" readonly="state != 'draft'"/>
              <field name="timezone"/>
              <field name="duration" widget="float_time"/>
            </group>
          </group>
          <field name="reason" readonly="state != 'draft'"/>
          <group string="سجل الموافقات">
            <field name="supervisor_user_id"/>
            <field name="supervisor_approved_at"/>
            <field name="manager_user_id"/>
            <field name="manager_approved_at"/>
            <field name="hr_user_id"/>
            <field name="hr_approved_at"/>
          </group>
          <notebook>
            <page string="سجلات العمل" groups="hr_payroll.group_hr_payroll_user">
              <field name="work_entry_ids" readonly="1">
                <list create="0" edit="0" delete="0">
                  <field name="date"/>
                  <field name="work_entry_type_id"/>
                  <field name="duration" widget="float_time"/>
                  <field name="overtime_multiplier"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="overtime_search" model="ir.ui.view">
    <field name="name">thamar.overtime.request.search</field>
    <field name="model">thamar.overtime.request</field>
    <field name="arch" type="xml">
      <search>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="name"/>
        <filter name="pending" string="بانتظار الموافقة" domain="[('state', 'in', ['supervisor', 'manager'])]"/>
        <filter name="approved" string="معتمد" domain="[('state', '=', 'approved')]"/>
        <group>
          <filter name="department" string="القسم" context="{'group_by': 'department_id'}"/>
          <filter name="state" string="الحالة" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_overtime" model="ir.actions.act_window">
    <field name="name">طلبات العمل الإضافي</field>
    <field name="res_model">thamar.overtime.request</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('kind', '!=', 'mission')]</field>
  </record>
  <record id="action_missions" model="ir.actions.act_window">
    <field name="name">المأموريات</field>
    <field name="res_model">thamar.overtime.request</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('kind', '=', 'mission')]</field>
    <field name="context">{'default_kind': 'mission'}</field>
  </record>
  <menuitem id="menu_overtime_root" name="العمل الإضافي والمأموريات" sequence="95" groups="thamar_holiday_overtime.group_overtime_user,thamar_holiday_overtime.group_overtime_manager,thamar_holiday_overtime.group_overtime_hr_admin"/>
  <menuitem id="menu_overtime_requests" parent="menu_overtime_root" action="action_overtime" name="العمل الإضافي" sequence="10" groups="thamar_holiday_overtime.group_overtime_user,thamar_holiday_overtime.group_overtime_manager,thamar_holiday_overtime.group_overtime_hr_admin"/>
  <menuitem id="menu_missions" parent="menu_overtime_root" action="action_missions" name="المأموريات" sequence="20" groups="thamar_holiday_overtime.group_overtime_user,thamar_holiday_overtime.group_overtime_manager,thamar_holiday_overtime.group_overtime_hr_admin"/>
  <record id="company_overtime_form" model="ir.ui.view">
    <field name="name">res.company.overtime</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="العمل الإضافي">
          <group>
            <field name="overtime_day_start" widget="float_time"/>
            <field name="overtime_day_end" widget="float_time"/>
            <field name="overtime_holiday_multiplier"/>
            <field name="overtime_policy_confirmed"/>
          </group>
          <p>النهاري ×1.35، وكل الساعات خارج الفترة النهارية مسائي ×1.70. تشغيل يوم العطلة ×2 من الأجر اليومي. لا يمكن اعتماد طلبات الساعات قبل تأكيد هذه السياسة.</p>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
