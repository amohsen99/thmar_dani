<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The old list header and server action call a method that no longer
        exists. Keep their XML IDs on upgrade, but make them inert. The other
        legacy view XML IDs are deliberately reused by the new view files.
    -->
    <record id="product_product_tfree_view_inherit_barcode" model="ir.ui.view">
        <field name="name">product.product.tree.legacy.barcode.disabled</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside"/>
        </field>
    </record>
    <record id="action_generate_barcode_batch" model="ir.actions.server">
        <field name="name">Legacy barcode generation (disabled)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_view_types"/>
        <field name="state">code</field>
        <field name="code">pass</field>
    </record>
</odoo>
